{%- style -%}
  .breadcrumb-banner-wrap,
  .breadcrumb-banner,
  .section-breadcrumb-banner {
    background-color: #DA6634 !important;
    background-image: none !important;
    background: #DA6634 !important;
    --color-background: 218, 102, 52 !important;
    --gradient-background: #DA6634 !important;
    padding-top: 36px !important;
    padding-bottom: 36px !important;
    margin: 0 !important;
    position: relative;
    z-index: 2;
  }

  .breadcrumb-banner .container,
  .breadcrumb-banner .page-width,
  .breadcrumb-banner-wrap .container {
    background: transparent !important;
  }

  .breadcrumb-banner .title,
  .breadcrumb-banner h1,
  .breadcrumb-banner h2,
  .breadcrumb-banner .h1,
  .breadcrumb-banner .h2 {
    color: #FFFFFF !important;
    font-size: clamp(32px, 4vw, 44px) !important;
    font-weight: 900 !important;
    text-transform: capitalize !important;
    margin-bottom: 8px !important;
    line-height: 1.1 !important;
  }

  .breadcrumb-banner .breadcrumb,
  .breadcrumb-banner .breadcrumb *,
  .breadcrumb-banner a,
  .breadcrumb-banner span {
    color: rgba(255, 255, 255, 0.85) !important;
    font-size: 13px !important;
    text-decoration: none !important;
  }

  .breadcrumb-banner a:hover {
    color: #FFFFFF !important;
    text-decoration: underline !important;
  }

  .breadcrumb-banner svg,
  .breadcrumb-banner svg path {
    fill: rgba(255, 255, 255, 0.85) !important;
  }
{%- endstyle -%}

<div class="breadcrumb-banner-wrap">
  <div class="breadcrumb-banner text-center">
    <div class="container page-width">
      <h1 class="title mb-2">
        {%- if template contains 'page' -%}
          {{ page.title }}
        {%- elsif template contains 'product' -%}
          {{ product.title }}
        {%- elsif template contains 'collection' and collection.handle -%}
          {{ collection.title }}
        {%- elsif template == 'blog' -%}
          {{ blog.title }}
        {%- elsif template == 'article' -%}
          {{ article.title }}
        {%- elsif template contains 'cart' -%}
          {{ 'templates.cart.cart' | t }}
        {%- elsif template contains 'search' -%}
          {{ 'templates.search.title' | t }}
        {%- else -%}
          {{ page_title }}
        {%- endif -%}
      </h1>

      <nav class="breadcrumb justify-content-center d-flex align-items-center gap-2" role="navigation" aria-label="breadcrumbs">
        <a href="{{ routes.root_url }}" title="{{ 'general.breadcrumbs.home' | t }}">
          {{ 'general.breadcrumbs.home' | t }}
        </a>
        <span class="breadcrumb-separator" aria-hidden="true">&rsaquo;</span>
        <span>
          {%- if template contains 'page' -%}
            {{ page.title }}
          {%- elsif template contains 'product' -%}
            {{ product.title }}
          {%- elsif template contains 'collection' and collection.handle -%}
            {{ collection.title }}
          {%- else -%}
            {{ page_title }}
          {%- endif -%}
        </span>
      </nav>
    </div>
  </div>
</div>
