{% doc %}
  @prompt
    Hide product prices across all product cards (collection/listing pages) and product detail pages. Replace the add-to-cart button with a "Get in touch for your quote" call-to-action that links to /pages/contact. The button should match the store's existing button styling (warm retro aesthetic with paprika rust accent colour).
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-quote-cta-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-quote-cta-{{ ai_gen_id }}__button {
    display: inline-flex;
    width: 100%;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    padding: 14px 22px;
    border: 1px solid {{ block.settings.button_color }};
    border-radius: {{ block.settings.border_radius }}px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    font-family: inherit;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.02em;
    text-align: center;
    text-decoration: none;
    transition: background-color 160ms ease, color 160ms ease;
  }

  .ai-quote-cta-{{ ai_gen_id }}__button:hover {
    background: {{ block.settings.button_hover_color }};
    border-color: {{ block.settings.button_hover_color }};
    color: {{ block.settings.button_text_color }};
  }

  .ai-quote-cta-{{ ai_gen_id }}__button:focus-visible {
    outline: 3px solid {{ block.settings.focus_color }};
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-quote-cta-{{ ai_gen_id }}__button { transition: none; }
  }
{% endstyle %}

<div class="ai-quote-cta-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <a class="ai-quote-cta-{{ ai_gen_id }}__button" href="{{ block.settings.contact_link | default: '/pages/contact' }}">
    {{ block.settings.button_label | escape }}
  </a>
</div>

{% schema %}
{
  "name": "Quote contact button",
  "settings": [
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Get in touch for your quote" },
    { "type": "url", "id": "contact_link", "label": "Contact page link" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "button_color", "label": "Background", "default": "#DA6634" },
    { "type": "color", "id": "button_text_color", "label": "Text", "default": "#ffffff" },
    { "type": "color", "id": "button_hover_color", "label": "Hover background", "default": "#A74726" },
    { "type": "color", "id": "focus_color", "label": "Focus outline", "default": "#231F1A" },
    { "type": "range", "id": "border_radius", "label": "Corner radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 0 }
  ],
  "presets": [{ "name": "Quote contact button" }],
  "tag": null,
  "class": "quote-contact-button-block"
}
{% endschema %}