      "blocks": {
        "text_wU99YB": {
          "type": "text",
          "settings": {
            "text": "<p>With approximately 2.4 million UK adults living with a confirmed food allergy and over half of daily adult calories coming from ultra-processed food, our starting point was simple: dinner shouldn't come with a disclaimer.<\/p><p>We formulate every sauce free from all 14 major allergens and completely free from NOVA-classified ultra-processed additives. One range that works for every guest on every menu.<\/p>",
            "margin_top": 3
          }
        },
        "button_rmdPKf": {
