<div class="container page-width section-{{ section.id }}-padding" style="background:{{ section.settings.bg_color }};">
  {% render 'heading',
    heading: section.settings.heading,
    heading_tag: section.settings.heading_tag,
    heading_size: 'h2',
    preheading: section.settings.preheading,
    subheading: section.settings.subheading
  %}

  <div class="nsc-pkg-grid" style="margin-top:32px;">
    <div class="nsc-pkg-card" style="background:#F6DDB0;">
      <img src="{{ 'pkg-sachet.png' | asset_url }}" alt="Sachet" loading="lazy">
      <h4>Sachet</h4><span class="nsc-pkg-pill">Pour &amp; Go</span>
    </div>
    <div class="nsc-pkg-card" style="background:#F3CDBB;">
      <img src="{{ 'pkg-table-bottle.png' | asset_url }}" alt="Table Bottle" loading="lazy">
      <h4>Table Bottle</h4><span class="nsc-pkg-pill">Retail</span>
    </div>
    <div class="nsc-pkg-card" style="background:#E4E0CF;">
      <img src="{{ 'pkg-catering-bottle.png' | asset_url }}" alt="Catering Bottle" loading="lazy">
      <h4>Catering Bottle</h4><span class="nsc-pkg-pill">Foodservice</span>
    </div>
    <div class="nsc-pkg-card" style="background:#F0C9C3;">
      <img src="{{ 'pkg-tub-500.png' | asset_url }}" alt="500ml Tub" loading="lazy">
      <h4>500ml Tub</h4><span class="nsc-pkg-pill">Retail</span>
    </div>
    <div class="nsc-pkg-card" style="background:#EFD9C4;">
      <img src="{{ 'pkg-tub-bulk.png' | asset_url }}" alt="1lt / 2.2lt Tub" loading="lazy">
      <h4>1lt / 2.2lt Tub</h4><span class="nsc-pkg-pill">Foodservice &amp; Bulk</span>
    </div>
    <div class="nsc-pkg-card" style="background:#D8DCC6;">
      <img src="{{ 'pkg-bib.png' | asset_url }}" alt="5kg / 10kg BIB" loading="lazy">
      <h4>5kg / 10kg BIB</h4><span class="nsc-pkg-pill">Foodservice &amp; Bulk</span>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Packaging grid",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "preheading", "label": "Preheading", "default": "Every Format" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One range, every format you sell in." },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>Retail and foodservice share the same recipes and label artwork across shared formats.</p>" },
    { "type": "select", "id": "heading_tag", "options": [{ "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" }], "default": "h2", "label": "Heading tag" },
    { "type": "color", "id": "bg_color", "label": "Section background", "default": "#FBF3E4" }
  ],
  "presets": [{ "name": "Packaging grid" }]
}
{% endschema %}
