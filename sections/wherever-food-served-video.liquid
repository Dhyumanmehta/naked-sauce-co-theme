{% style %}
  .ambient-video-strip-{{ section.id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: #0b0a0a;
    line-height: 0;
    /* Optional subtle dark fade at top and bottom to blend seamlessly into adjacent dark sections */
    box-shadow: inset 0 20px 30px rgba(0, 0, 0, 0.7), inset 0 -20px 30px rgba(0, 0, 0, 0.7);
  }

  .ambient-video-strip-{{ section.id }} .video-wrapper {
    position: relative;
    width: 100%;
    height: {{ section.settings.desktop_height | default: '550px' }};
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .ambient-video-strip-{{ section.id }} .video-wrapper {
      height: {{ section.settings.mobile_height | default: '340px' }};
    }
  }

  .ambient-video-strip-{{ section.id }} video,
  .ambient-video-strip-{{ section.id }} iframe {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    min-width: 100%;
    min-height: 100%;
    width: auto;
    height: auto;
    object-fit: cover;
    pointer-events: none; /* Disables click pausing so it behaves purely as background scenery */
    border: none;
  }

  /* Dark ambient overlay to help it blend into the page */
  .ambient-video-strip-{{ section.id }} .video-overlay {
    position: absolute;
    inset: 0;
    background: rgba(14, 12, 11, {{ section.settings.overlay_opacity | default: 0.15 }});
    pointer-events: none;
    z-index: 1;
  }

  .ambient-video-strip-{{ section.id }} .empty-placeholder {
    height: 300px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.4);
    font-size: 14px;
    line-height: normal;
  }
{% endstyle %}

<div class="ambient-video-strip-{{ section.id }}">
  <div class="video-wrapper">
    <div class="video-overlay"></div>

    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}
    {%- elsif section.settings.video_url != blank -%}
      {%- if section.settings.video_url.type == 'youtube' -%}
        <iframe
          src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?autoplay=1&mute=1&loop=1&controls=0&showinfo=0&rel=0&playlist={{ section.settings.video_url.id }}"
          allow="autoplay; encrypted-media"
          tabindex="-1"
          aria-hidden="true">
        </iframe>
      {%- elsif section.settings.video_url.type == 'vimeo' -%}
        <iframe
          src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?autoplay=1&muted=1&loop=1&background=1"
          allow="autoplay; fullscreen"
          tabindex="-1"
          aria-hidden="true">
        </iframe>
      {%- endif -%}
    {%- else -%}
      <div class="empty-placeholder">
        Select or upload your MP4 video in the customizer
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Ambient Video Strip",
  "tag": "section",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Shopify-hosted video (MP4 file)"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Or external video URL",
      "accept": ["youtube", "vimeo"]
    },
    {
      "type": "select",
      "id": "desktop_height",
      "label": "Desktop Height",
      "options": [
        { "value": "420px", "label": "Compact (420px)" },
        { "value": "550px", "label": "Medium (550px)" },
        { "value": "700px", "label": "Tall / Cinematic (700px)" },
        { "value": "100vh", "label": "Full Screen (100vh)" }
      ],
      "default": "550px"
    },
    {
      "type": "select",
      "id": "mobile_height",
      "label": "Mobile Height",
      "options": [
        { "value": "260px", "label": "Compact (260px)" },
        { "value": "340px", "label": "Medium (340px)" },
        { "value": "450px", "label": "Tall (450px)" }
      ],
      "default": "340px"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 0.8,
      "step": 0.05,
      "label": "Dark tint over video",
      "default": 0.15
    }
  ],
  "presets": [
    {
      "name": "Ambient Video Strip"
    }
  ]
}
{% endschema %}
