{% style %}
  .wfs-video-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#141211' }};
    color: #ffffff;
    padding-top: clamp(60px, 7vw, 100px);
    padding-bottom: clamp(60px, 7vw, 100px);
    position: relative;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .wfs-video-{{ section.id }} .wfs-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .wfs-video-{{ section.id }} .wfs-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 40px;
    gap: 24px;
    flex-wrap: wrap;
  }

  .wfs-video-{{ section.id }} .wfs-title {
    font-size: clamp(34px, 4.2vw, 54px);
    font-weight: 900;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: #ffffff;
    margin: 0;
  }

  .wfs-video-{{ section.id }} .wfs-subtitle {
    font-size: clamp(15px, 1.25vw, 18px);
    color: rgba(255, 255, 255, 0.72);
    margin: 0;
    max-width: 480px;
    text-align: right;
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    .wfs-video-{{ section.id }} .wfs-subtitle {
      text-align: left;
    }
  }

  /* Video Display Frame */
  .wfs-video-{{ section.id }} .wfs-media-container {
    position: relative;
    width: 100%;
    border-radius: 18px;
    overflow: hidden;
    background-color: #0b0a0a;
    border: 1.5px solid rgba(218, 102, 52, 0.35);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6);
    aspect-ratio: 16 / 9;
    user-select: none;
  }

  /* Disables controls, cursor pointer, and pause clicks so it behaves purely like an ambient theme graphic */
  .wfs-video-{{ section.id }} video,
  .wfs-video-{{ section.id }} iframe {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border: none;
    pointer-events: none; /* Prevents click-to-pause and right-click menus */
  }

  .wfs-video-{{ section.id }} .wfs-empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: rgba(255, 255, 255, 0.5);
    font-size: 14px;
    padding: 30px;
    text-align: center;
  }
{% endstyle %}

<section class="wfs-video-{{ section.id }}" id="where-we-fit-video">
  <div class="wfs-inner">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="wfs-header">
        {%- if section.settings.heading != blank -%}
          <h2 class="wfs-title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="wfs-subtitle">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="wfs-media-container">
      {%- if section.settings.video != blank -%}
        {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}
      {%- elsif section.settings.video_url != blank -%}
        {%- if section.settings.video_url.type == 'youtube' -%}
          <iframe
            src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?autoplay=1&mute=1&loop=1&playlist={{ section.settings.video_url.id }}&controls=0&disablekb=1&modestbranding=1"
            allow="autoplay; encrypted-media"
            tabindex="-1"
            aria-hidden="true"
            title="{{ section.settings.heading }}">
          </iframe>
        {%- elsif section.settings.video_url.type == 'vimeo' -%}
          <iframe
            src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?autoplay=1&muted=1&loop=1&background=1"
            allow="autoplay; fullscreen"
            tabindex="-1"
            aria-hidden="true"
            title="{{ section.settings.heading }}">
          </iframe>
        {%- endif -%}
      {%- else -%}
        <div class="wfs-empty-state">
          <p style="font-size: 16px; font-weight: 700; color: #DA6634; margin-bottom: 6px;">No video selected</p>
          <p style="margin: 0;">Upload your video file (MP4) in the theme customizer or provide a link.</p>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Where We Fit (Video)",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wherever food is served"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "One range, built to work across every channel"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Shopify-hosted video (MP4 file)"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Or external video URL",
      "accept": ["youtube", "vimeo"]
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#141211"
    }
  ],
  "presets": [
    {
      "name": "Where We Fit (Video)"
    }
  ]
}
{% endschema %}
