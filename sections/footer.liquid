{% liquid
  assign footer_text_color = section.settings.color_footer_text
  assign footer_text_color_brightness = section.settings.color_footer_text | color_brightness
  if footer_text_color_brightness <= 40
    assign footer_text_muted = footer_text_color | color_lighten: 25
    assign footer_border_color = footer_text_color | color_modify: 'alpha', 0.15
  else
    assign footer_text_muted = footer_text_color | color_darken: 20
    assign footer_border_color = footer_text_color | color_modify: 'alpha', 0.12
  endif
%}

<style>
  .site-footer {
    background-color: {{ section.settings.color_footer_bg }};
    color: {{ section.settings.color_footer_text }};
    padding-top: 80px;
    padding-bottom: 30px;
    position: relative;
    font-size: 15px;
    line-height: 1.6;
  }

  {% if section.settings.border_top %}
  .site-footer {
    border-top: 1px solid {{ footer_border_color }};
  }
  {% endif %}

  .site-footer h2,
  .site-footer h3,
  .site-footer .footer-col-title {
    color: {{ section.settings.color_footer_text }};
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 24px;
  }

  .site-footer p,
  .site-footer .site-footer__rte {
    color: {{ footer_text_muted }};
    font-size: 15px;
    line-height: 1.6;
  }

  .site-footer__linklist {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .site-footer__linklist-item {
    margin-bottom: 12px;
  }

  .site-footer__linklist-item a {
    color: {{ footer_text_muted }};
    text-decoration: none;
    font-size: 15px;
    transition: color 0.2s ease, transform 0.2s ease;
    display: inline-block;
  }

  .site-footer__linklist-item a:hover {
    color: {{ section.settings.color_footer_text }};
    transform: translateX(3px);
  }

  /* Newsletter styling */
  .site-footer .footer-newsletter-box {
    margin-top: 20px;
  }

  .site-footer .newsletter-pill-group {
    display: flex;
    position: relative;
    border-radius: 50px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid {{ footer_border_color }};
    padding: 4px;
    transition: border-color 0.2s ease;
  }

  .site-footer .newsletter-pill-group:focus-within {
    border-color: {{ section.settings.color_footer_text }};
  }

  .site-footer .newsletter-pill-input {
    background: transparent;
    border: none;
    outline: none;
    padding: 12px 20px;
    color: {{ section.settings.color_footer_text }};
    font-size: 14px;
    flex-grow: 1;
    min-width: 0;
  }

  .site-footer .newsletter-pill-input::placeholder {
    color: {{ footer_text_muted }};
    opacity: 0.8;
  }

  .site-footer .newsletter-pill-btn {
    border-radius: 50px;
    background-color: {{ section.settings.color_footer_text }};
    color: {{ section.settings.color_footer_bg }};
    border: none;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 10px 22px;
    cursor: pointer;
    transition: opacity 0.2s ease, transform 0.15s ease;
  }

  .site-footer .newsletter-pill-btn:hover {
    opacity: 0.9;
    transform: scale(0.98);
  }

  /* Social Icons */
  .site-footer .footer-social-wrap {
    margin-top: 28px;
  }

  .site-footer .footer-social-wrap a {
    color: {{ section.settings.color_footer_text }};
    opacity: 0.8;
    margin-right: 16px;
    font-size: 18px;
    transition: opacity 0.2s ease;
  }

  .site-footer .footer-social-wrap a:hover {
    opacity: 1;
  }

  /* Bottom Bar */
  .site-footer .footer-bottom-bar {
    margin-top: 60px;
    padding-top: 24px;
    border-top: 1px solid {{ footer_border_color }};
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    font-size: 13px;
    color: {{ footer_text_muted }};
  }

  .site-footer .footer-bottom-bar a {
    color: {{ footer_text_muted }};
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .site-footer .footer-bottom-bar a:hover {
    color: {{ section.settings.color_footer_text }};
  }

  .site-footer .footer-policies-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }

  .site-footer .payment-icons {
    display: flex;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .site-footer .disclosure__toggle {
    background: transparent;
    border: 1px solid {{ footer_border_color }};
    border-radius: 20px;
    padding: 6px 14px;
    color: {{ section.settings.color_footer_text }};
    font-size: 12px;
  }
</style>

<footer
  class="site-footer"
  role="contentinfo"
  data-section-id="{{ section.id }}"
  data-section-type="footer-section"
>
  <div class="container page-width">
    <div class="row gx-lg-5 gy-5">
      <!-- Left Column: Brand & Newsletter -->
      <div class="col-12 col-lg-5">
        <h2 class="footer-col-title">{{ section.settings.heading }}</h2>
        {% if section.settings.subheading != blank %}
          <div class="site-footer__rte mb-4">
            {{ section.settings.subheading }}
          </div>
        {% endif %}

        {% if section.settings.show_newsletter %}
          <div class="footer-newsletter-box">
            {% assign form_id = 'ContactFooter' %}
            {% form 'customer', id: form_id, novalidate: 'novalidate' %}
              {% if form.posted_successfully? %}
                <p class="text-success small mb-2" tabindex="-1">
                  {{ 'general.newsletter_form.confirmation' | t }}
                </p>
              {% endif %}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div class="newsletter-pill-group">
                <input
                  type="email"
                  name="contact[email]"
                  id="{{ form_id }}-email"
                  class="newsletter-pill-input"
                  value="{{ form.email }}"
                  placeholder="{{ 'general.newsletter_form.email_placeholder' | t }}"
                  required
                  autocorrect="off"
                  autocapitalize="off"
                >
                <button type="submit" class="newsletter-pill-btn" name="commit">
                  <span>{{ 'general.newsletter_form.submit' | t }}</span>
                </button>
              </div>
            {% endform %}
          </div>
        {% endif %}

        {% if section.settings.show_socials_icons %}
          <div class="footer-social-wrap">
            {% render 'social', class: '' %}
          </div>
        {% endif %}
      </div>

      <!-- Right Column: Navigation & Content Blocks -->
      <div class="col-12 col-lg-7">
        <div class="row gx-4 gy-4">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'link_list' %}
                <div class="col-6 col-md-4" {{ block.shopify_attributes }}>
                  <h3 class="footer-col-title">{{ block.settings.title }}</h3>
                  {% assign footer_linklist = block.settings.menu %}
                  <ul class="site-footer__linklist">
                    {% for link in linklists[footer_linklist].links %}
                      <li class="site-footer__linklist-item">
                        <a href="{{ link.url }}">{{ link.title | escape }}</a>
                      </li>
                    {% endfor %}
                  </ul>
                </div>

              {% when 'text' %}
                <div class="col-12 col-md-4" {{ block.shopify_attributes }}>
                  <h3 class="footer-col-title">{{ block.settings.title }}</h3>
                  {% if block.settings.text != blank %}
                    <div class="site-footer__rte">
                      {{ block.settings.text }}
                    </div>
                  {% endif %}
                </div>

              {% when 'gallery' %}
                <div class="col-12 col-md-4" {{ block.shopify_attributes }}>
                  <h3 class="footer-col-title">{{ block.settings.title }}</h3>
                  <div class="row g-2">
                    {% for i in (1..6) %}
                      {% capture img_key %}image{{ i }}{% endcapture %}
                      {% if block.settings[img_key] != blank %}
                        <div class="col-4">
                          {% render 'image', lazyload: true, image: block.settings[img_key], class: 'rounded' %}
                        </div>
                      {% endif %}
                    {% endfor %}
                  </div>
                </div>
            {% endcase %}
          {% endfor %}
        </div>
      </div>
    </div>

    <!-- Bottom Utility Bar -->
    <div class="footer-bottom-bar">
      <div>
        {% if section.settings.copyright != blank %}
          <span>{{ section.settings.copyright }}</span>
        {% else %}
          <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>
        {% endif %}
      </div>

      {% if section.settings.show_policy %}
        <ul class="footer-policies-list">
          {% for policy in shop.policies %}
            {% if policy != blank %}
              <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
            {% endif %}
          {% endfor %}
        </ul>
      {% endif %}

      {% if section.settings.show_payment_icons %}
        <ul class="payment-icons">
          {% for type in shop.enabled_payment_types %}
            <li>{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Brand / Newsletter Heading",
      "default": "Naked Sauce Co."
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Brand Description / Subheading",
      "default": "<p>Bold flavour. Nothing to hide. Allergen-free, clean-label sauces for retail & foodservice.</p>"
    },
    {
      "type": "header",
      "content": "Colors & Borders"
    },
    {
      "type": "color",
      "id": "color_footer_bg",
      "label": "Background Color",
      "default": "#231F1A"
    },
    {
      "type": "color",
      "id": "color_footer_text",
      "label": "Text Color",
      "default": "#FBF3E4"
    },
    {
      "type": "checkbox",
      "id": "border_top",
      "label": "Show subtle top border",
      "default": true
    },
    {
      "type": "header",
      "content": "Features"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter subscription",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_socials_icons",
      "label": "Show social media icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_policy",
      "label": "Show policy links",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "richtext",
      "id": "copyright",
      "label": "Custom Copyright Text"
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Navigation Menu",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Quick links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text Column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Trade Inquiries"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Content",
          "default": "<p>Need bulk, foodservice, or retail wholesale? Email sales@thenakedsauceco.com</p>"
        }
      ]
    },
    {
      "type": "gallery",
      "name": "Gallery",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Follow Us"
        },
        { "type": "image_picker", "id": "image1", "label": "Image 1" },
        { "type": "image_picker", "id": "image2", "label": "Image 2" },
        { "type": "image_picker", "id": "image3", "label": "Image 3" },
        { "type": "image_picker", "id": "image4", "label": "Image 4" },
        { "type": "image_picker", "id": "image5", "label": "Image 5" },
        { "type": "image_picker", "id": "image6", "label": "Image 6" }
      ]
    }
  ]
}
{% endschema %}