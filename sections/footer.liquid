{% liquid
  assign footer_text_color = section.settings.color_footer_text | default: '#FBF3E4'
  assign footer_bg = section.settings.color_footer_bg | default: '#141110'
  assign footer_border = 'rgba(251, 243, 228, 0.12)'
%}

{% style %}
  .nsc-footer {
    background-color: {{ footer_bg }};
    color: {{ footer_text_color }};
    padding-top: 70px;
    padding-bottom: 35px;
    font-size: 14px;
    line-height: 1.6;
    border-top: 1px solid {{ footer_border }};
  }

  .nsc-footer .nsc-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .nsc-footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 48px;
    margin-bottom: 50px;
  }

  @media (max-width: 960px) {
    .nsc-footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 36px;
    }
  }

  @media (max-width: 560px) {
    .nsc-footer-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  .nsc-footer-logo {
    height: 42px;
    width: auto;
    margin-bottom: 18px;
    display: block;
  }

  .nsc-footer-col-title {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #FBF3E4;
    margin: 0 0 18px;
  }

  .nsc-footer p,
  .nsc-footer-desc {
    color: #D6CDBF;
    font-size: 14px;
    line-height: 1.65;
    margin: 0 0 16px;
  }

  .nsc-footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .nsc-footer-links a {
    color: #D6CDBF;
    text-decoration: none;
    font-size: 14px;
    transition: color 0.18s ease;
  }

  .nsc-footer-links a:hover {
    color: #DA6634;
  }

  .nsc-footer-bottom {
    margin-top: 40px;
    padding-top: 25px;
    border-top: 1px solid {{ footer_border }};
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    font-size: 12.5px;
    color: #A39B8F;
  }

  .nsc-footer-bottom a {
    color: #A39B8F;
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .nsc-footer-bottom a:hover {
    color: #FBF3E4;
  }

  .nsc-footer-policies {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
  }
{% endstyle %}

<footer class="nsc-footer" role="contentinfo">
  <div class="nsc-inner">
    
    <div class="nsc-footer-grid">
      <div>
        {% if settings.logo != blank %}
          <img src="{{ settings.logo | image_url: width: 300 }}" alt="{{ shop.name }}" class="nsc-footer-logo">
        {% else %}
          <h3 style="color: #FBF3E4; font-weight: 900; margin-bottom: 14px;">The Naked Sauce Co.</h3>
        {% endif %}
        <p class="nsc-footer-desc" style="max-width: 320px;">
          Bold flavour, nothing to hide. Clean label table and cooking sauces made without the 14 major allergens or ultra-processed ingredients.
        </p>
      </div>

      <div>
        <h4 class="nsc-footer-col-title">Navigation</h4>
        <ul class="nsc-footer-links">
          <li><a href="/#our-sauces">Our sauces</a></li>
          <li><a href="/#our-story">Our story</a></li>
          <li><a href="/#where-we-fit">Where we fit</a></li>
          <li><a href="/pages/contact">Contact us</a></li>
        </ul>
      </div>

      <div>
        <h4 class="nsc-footer-col-title">Policies</h4>
        <ul class="nsc-footer-links">
          {% assign has_policies = false %}
          {% for policy in shop.policies %}
            {% if policy.body != blank %}
              {% assign has_policies = true %}
              <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
            {% endif %}
          {% endfor %}
          {% unless has_policies %}
            <li><a href="/policies/privacy-policy">Privacy policy</a></li>
            <li><a href="/policies/terms-of-service">Terms of service</a></li>
            <li><a href="/policies/refund-policy">Refund policy</a></li>
          {% endunless %}
        </ul>
      </div>

      <div>
        <h4 class="nsc-footer-col-title">Get in touch</h4>
        <p class="nsc-footer-desc">For commercial inquiries, development samples, and trade orders:</p>
        <p style="margin: 0;">
          <a href="mailto:{{ shop.email | default: 'info@thenakedsauceco.com' }}" style="color: #DA6634; text-decoration: none; font-weight: 700;">
            {{ shop.email | default: 'info@thenakedsauceco.com' }}
          </a>
        </p>
      </div>
    </div>

    <div class="nsc-footer-bottom">
      <div>
        <span>&copy; {{ 'now' | date: '%Y' }} The Naked Sauce Co. Ltd. All rights reserved.</span>
      </div>

      <ul class="nsc-footer-policies">
        {% assign has_policies = false %}
        {% for policy in shop.policies %}
          {% if policy.body != blank %}
            {% assign has_policies = true %}
            <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
          {% endif %}
        {% endfor %}
        {% unless has_policies %}
          <li><a href="/policies/privacy-policy">Privacy</a></li>
          <li><a href="/policies/terms-of-service">Terms</a></li>
        {% endunless %}
      </ul>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "color",
      "id": "color_footer_bg",
      "label": "Background Color",
      "default": "#141110"
    },
    {
      "type": "color",
      "id": "color_footer_text",
      "label": "Text Color",
      "default": "#FBF3E4"
    }
  ]
}
{% endschema %}
