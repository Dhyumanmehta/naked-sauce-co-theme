{% liquid
  assign footer_text_color = section.settings.color_footer_text | default: '#FBF3E4'
  assign footer_bg = section.settings.color_footer_bg | default: '#231F1A'
  assign footer_border = 'rgba(251, 243, 228, 0.12)'
%}

<style>
  .nsc-footer {
    background-color: {{ footer_bg }};
    color: {{ footer_text_color }};
    padding-top: 75px;
    padding-bottom: 35px;
    font-size: 14.5px;
    line-height: 1.6;
    border-top: 1px solid {{ footer_border }};
  }

  .nsc-footer-top {
    border-bottom: 1px solid {{ footer_border }};
    padding-bottom: 40px;
    margin-bottom: 50px;
  }

  .nsc-footer-badge-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
  }

  .nsc-footer-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 50px;
    background: rgba(251, 243, 228, 0.06);
    border: 1px solid rgba(251, 243, 228, 0.16);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #FBF3E4;
  }

  .nsc-footer-pill-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #DA6634;
  }

  .nsc-footer-col-title {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #FBF3E4;
    margin-bottom: 20px;
  }

  .nsc-footer p,
  .nsc-footer-desc {
    color: #D6CDBF;
    font-size: 14px;
    line-height: 1.65;
    margin-bottom: 20px;
  }

  .nsc-footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nsc-footer-links li {
    margin-bottom: 10px;
  }

  .nsc-footer-links a {
    color: #D6CDBF;
    text-decoration: none;
    font-size: 14px;
    transition: color 0.18s ease, transform 0.18s ease;
    display: inline-block;
  }

  .nsc-footer-links a:hover {
    color: #FFFFFF;
    transform: translateX(3px);
  }

  /* Newsletter Box */
  .nsc-footer-newsletter {
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid {{ footer_border }};
    border-radius: 12px;
    padding: 24px;
  }

  .nsc-footer-input-group {
    display: flex;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(251, 243, 228, 0.18);
    border-radius: 50px;
    padding: 4px;
    margin-top: 14px;
    transition: border-color 0.2s ease;
  }

  .nsc-footer-input-group:focus-within {
    border-color: #DA6634;
  }

  .nsc-footer-input {
    background: transparent;
    border: none;
    outline: none;
    color: #FBF3E4;
    font-size: 13.5px;
    padding: 10px 18px;
    flex-grow: 1;
    min-width: 0;
  }

  .nsc-footer-input::placeholder {
    color: #A39B8F;
  }

  .nsc-footer-btn {
    background: #DA6634;
    color: #FFFFFF;
    border: none;
    border-radius: 50px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 10px 20px;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.15s ease;
  }

  .nsc-footer-btn:hover {
    background: #E87442;
    transform: scale(0.98);
  }

  /* Packaging Formats Row */
  .nsc-footer-formats {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
  }

  .nsc-format-tag {
    font-size: 11.5px;
    padding: 3px 10px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.05);
    color: #A39B8F;
    border: 1px solid rgba(255, 255, 255, 0.07);
  }

  /* Bottom Bar */
  .nsc-footer-bottom {
    margin-top: 60px;
    padding-top: 25px;
    border-top: 1px solid {{ footer_border }};
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    font-size: 12.5px;
    color: #A39B8F;
  }

  .nsc-footer-bottom a {
    color: #A39B8F;
    text-decoration: none;
  }

  .nsc-footer-bottom a:hover {
    color: #FBF3E4;
  }

  .nsc-footer-policies {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
  }
</style>

<footer class="nsc-footer" role="contentinfo">
  <div class="container page-width">
    <!-- Top Standards Banner (From Philosophy Document) -->
    <div class="nsc-footer-top d-flex justify-content-between align-items-center flex-wrap gap-3">
      <div class="nsc-footer-badge-strip">
        <span class="nsc-footer-pill">
          <span class="nsc-footer-pill-dot"></span>
          Free From All 14 Major Allergens
        </span>
        <span class="nsc-footer-pill">
          <span class="nsc-footer-pill-dot" style="background:#5F6B3E;"></span>
          100% UPF-Free
        </span>
        <span class="nsc-footer-pill">
          <span class="nsc-footer-pill-dot"></span>
          One Recipe. Every Table.
        </span>
      </div>
      <div>
        {% if section.settings.show_socials_icons %}
          {% render 'social', class: '' %}
        {% endif %}
      </div>
    </div>

    <!-- Main Columns -->
    <div class="row gx-lg-5 gy-5">
          <li><a href="mailto:sales@thenakedsauceco.com">sales@thenakedsauceco.com</a></li>
        </ul>
      </div>



    <!-- Bottom Utility Bar -->
    <div class="nsc-footer-bottom">
      <div>
        <span>&copy; {{ 'now' | date: '%Y' }} The Naked Sauce Co. Ltd </span>
      </div>

      {% if section.settings.show_policy %}
        <ul class="nsc-footer-policies">
          {% for policy in shop.policies %}
            {% if policy != blank %}
              <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
            {% endif %}
          {% endfor %}
        </ul>
      {% endif %}

      {% if section.settings.show_payment_icons %}
        <ul class="d-flex list-unstyled gap-2 mb-0">
          {% for type in shop.enabled_payment_types %}
            <li>{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Company Title",
      "default": "The Naked Sauce Co."
    },
    {
      "type": "color",
      "id": "color_footer_bg",
      "label": "Background Color",
      "default": "#231F1A"
    },
    {
      "type": "color",
      "id": "color_footer_text",
      "label": "Text Color",
      "default": "#FBF3E4"
    },
    {
      "type": "checkbox",
      "id": "show_socials_icons",
      "label": "Show social media icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_policy",
      "label": "Show policy links",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    }
  ]
}
{% endschema %}
