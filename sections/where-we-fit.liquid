{% style %}
  .nsc-fit-section-{{ section.id }} {
    background-color: #141312;
    color: #ffffff;
    padding: 90px 0 100px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .nsc-fit-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .nsc-fit-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 48px;
    gap: 30px;
    flex-wrap: wrap;
  }

  .nsc-fit-title {
    font-size: clamp(38px, 4.5vw, 56px);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0;
    color: #ffffff;
  }

  .nsc-fit-sub {
    font-size: clamp(15px, 1.2vw, 18px);
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.4;
    margin: 0;
    max-width: 440px;
    text-align: right;
  }

  @media (max-width: 768px) {
    .nsc-fit-header-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
    .nsc-fit-sub {
      text-align: left;
    }
  }

  .nsc-fit-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 18px;
  }

  @media (max-width: 1100px) {
    .nsc-fit-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 767px) {
    .nsc-fit-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .nsc-fit-section-{{ section.id }} {
      padding: 60px 0;
    }
  }

  /* Orange Bordered Channel Card */
  .nsc-fit-card {
    background: rgba(218, 102, 52, 0.08);
    border: 2px solid #DA6634;
    border-radius: 10px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .nsc-fit-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 24px rgba(218, 102, 52, 0.25);
  }

  .nsc-fit-media {
    width: 100%;
    aspect-ratio: 4 / 3;
    background: rgba(0, 0, 0, 0.25);
    border-bottom: 1px solid rgba(218, 102, 52, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .nsc-fit-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .nsc-fit-media-placeholder {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.45);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .nsc-fit-body {
    padding: 20px 16px;
    flex-grow: 1;
  }

  .nsc-fit-name {
    font-size: 18px;
    font-weight: 800;
    color: #DA6634;
    margin: 0 0 10px;
    line-height: 1.2;
  }

  .nsc-fit-desc {
    font-size: 13px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.85);
    margin: 0;
  }
{% endstyle %}

<div class="nsc-fit-section-{{ section.id }}" id="where-we-fit">
  <div class="nsc-fit-container">
    <div class="nsc-fit-header-row">
      <h2 class="nsc-fit-title">{{ section.settings.title | default: 'Wherever food is served' }}</h2>
      <p class="nsc-fit-sub">{{ section.settings.subtitle | default: 'One range, built to work across every channel' }}</p>
    </div>

    <div class="nsc-fit-grid">
      {% for block in section.blocks %}
        <div class="nsc-fit-card" {{ block.shopify_attributes }}>
          <div class="nsc-fit-media">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 500 }}" alt="{{ block.settings.title }}" loading="lazy">
            {% else %}
              <span class="nsc-fit-media-placeholder">{{ block.settings.title }} Photo</span>
            {% endif %}
          </div>
          <div class="nsc-fit-body">
            <h3 class="nsc-fit-name">{{ block.settings.title }}</h3>
            <p class="nsc-fit-desc">{{ block.settings.description }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Where We Fit Channels",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Wherever food is served" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "One range, built to work across every channel" }
  ],
  "blocks": [
    {
      "type": "channel",
      "name": "Channel Card",
      "settings": [
        { "type": "text", "id": "title", "label": "Channel Title", "default": "Channel" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Channel description goes here." },
        { "type": "image_picker", "id": "image", "label": "Channel Photo" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Where We Fit Channels",
      "blocks": [
        {
          "type": "channel",
          "settings": {
            "title": "Retail",
            "description": "On the shelf and ready for the table at home."
          }
        },
        {
          "type": "channel",
          "settings": {
            "title": "Foodservice",
            "description": "Contract catering, education and workplace."
          }
        },
        {
          "type": "channel",
          "settings": {
            "title": "Pubs & restaurants",
            "description": "On the table and on the plate."
          }
        },
        {
          "type": "channel",
          "settings": {
            "title": "Out of home",
            "description": "Behind the counter and back of house."
          }
        },
        {
          "type": "channel",
          "settings": {
            "title": "Industrial",
            "description": "An ingredient for food manufacturers."
          }
        }
      ]
    }
  ]
}
{% endschema %}
