{% style %}
  .hero-corporate-{{ section.id }} {
    background-color: #141312;
    color: #ffffff;
    position: relative;
    overflow: hidden;
    padding-top: clamp(60px, 8vw, 110px);
    padding-bottom: clamp(60px, 8vw, 110px);
  }

  .hero-corporate-{{ section.id }} .hero-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .hero-corporate-{{ section.id }} .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: center;
  }

  @media (max-width: 960px) {
    .hero-corporate-{{ section.id }} .hero-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  .hero-corporate-{{ section.id }} .hero-headline {
    font-size: clamp(42px, 5.5vw, 72px);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin: 0 0 24px;
  }

  .hero-corporate-{{ section.id }} .hero-subheading {
    font-size: clamp(16px, 1.4vw, 20px);
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.78);
    margin: 0 0 36px;
    max-width: 560px;
  }

  .hero-corporate-{{ section.id }} .hero-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    align-items: center;
  }

  .hero-corporate-{{ section.id }} .hero-btn-primary {
    background-color: #DA6634;
    color: #ffffff !important;
    padding: 15px 34px;
    font-size: 14px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    border-radius: 4px;
    display: inline-block;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .hero-corporate-{{ section.id }} .hero-btn-primary:hover {
    background-color: #c75626;
    transform: translateY(-2px);
  }

  .hero-corporate-{{ section.id }} .hero-btn-secondary {
    background-color: transparent;
    color: #ffffff !important;
    border: 1.5px solid rgba(255, 255, 255, 0.35);
    padding: 14px 32px;
    font-size: 14px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    border-radius: 4px;
    display: inline-block;
    transition: all 0.2s ease;
  }

  .hero-corporate-{{ section.id }} .hero-btn-secondary:hover {
    border-color: #DA6634;
    background: rgba(218, 102, 52, 0.12);
    color: #DA6634 !important;
    transform: translateY(-2px);
  }

  .hero-corporate-{{ section.id }} .hero-media-wrap {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .hero-corporate-{{ section.id }} .hero-img {
    width: 100%;
    height: 100%;
    max-height: 520px;
    object-fit: cover;
    display: block;
  }
{% endstyle %}

<section class="hero-corporate-{{ section.id }}">
  <div class="hero-inner">
    <div class="hero-grid">
      <!-- Left Content -->
      <div class="hero-content">
        <h1 class="hero-headline">
          {{ section.settings.headline | default: "Bold Flavour. Nothing to hide." }}
        </h1>
        <p class="hero-subheading">
          {{ section.settings.subheading | default: "Clean label sauces, free from the major allergens and made without any ultra-processed ingredients." }}
        </p>
        <div class="hero-actions">
          <a href="/pages/contact" class="hero-btn-primary">
            {{ section.settings.btn_primary_label | default: "Contact us" }}
          </a>
          <a href="/#our-sauces" class="hero-btn-secondary">
            {{ section.settings.btn_secondary_label | default: "Explore our range" }}
          </a>
        </div>
      </div>

      <!-- Right Media -->
      <div class="hero-media-wrap">
        {% if section.settings.hero_image != blank %}
          {{ section.settings.hero_image | image_url: width: 1000 | image_tag: class: 'hero-img', alt: 'The Naked Sauce Co Chef' }}
        {% else %}
          <img class="hero-img" src="{{ 'hero-chef.jpg' | asset_url }}" alt="Chef in The Naked Sauce Co apron">
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Corporate",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Bold Flavour. Nothing to hide."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Clean label sauces, free from the major allergens and made without any ultra-processed ingredients."
    },
    {
      "type": "text",
      "id": "btn_primary_label",
      "label": "Primary Button Label",
      "default": "Contact us"
    },
    {
      "type": "text",
      "id": "btn_secondary_label",
      "label": "Secondary Button Label",
      "default": "Explore our range"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    }
  ],
  "presets": [
    {
      "name": "Hero Corporate"
    }
  ]
}
{% endschema %}
