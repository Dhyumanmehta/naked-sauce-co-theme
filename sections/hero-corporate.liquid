{% style %}
  .nsc-hero-corporate-{{ section.id }} {
    background-color: #1e1e1e;
    color: #ffffff;
    padding: 70px 0 90px;
    position: relative;
    overflow: hidden;
  }

  .nsc-hero-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 32px;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: center;
  }

  @media (max-width: 991px) {
    .nsc-hero-container {
      grid-template-columns: 1fr;
      padding: 0 20px;
      gap: 40px;
    }
    .nsc-hero-corporate-{{ section.id }} {
      padding: 40px 0 60px;
    }
  }

  .nsc-hero-headline {
    font-size: clamp(48px, 6vw, 92px);
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin: 0 0 28px;
    text-transform: none;
  }

  .nsc-hero-subtext {
    font-size: clamp(16px, 1.3vw, 20px);
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.75);
    max-width: 480px;
    margin: 0 0 36px;
  }

  .nsc-hero-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .nsc-btn-primary {
    background-color: #DA6634;
    color: #ffffff !important;
    padding: 14px 28px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    border-radius: 4px;
    border: 1px solid #DA6634;
    transition: background-color 0.2s ease, transform 0.2s ease;
    display: inline-block;
  }

  .nsc-btn-primary:hover {
    background-color: #c75626;
    border-color: #c75626;
  }

  .nsc-btn-secondary {
    background-color: transparent;
    color: #ffffff !important;
    padding: 14px 28px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.75);
    transition: background-color 0.2s ease, border-color 0.2s ease;
    display: inline-block;
  }

  .nsc-btn-secondary:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: #ffffff;
  }

  /* Right Side Image Box */
  .nsc-hero-media-wrap {
    position: relative;
    width: 100%;
    min-height: 480px;
    border: 1.5px dashed rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.02);
  }

  @media (max-width: 991px) {
    .nsc-hero-media-wrap {
      min-height: 380px;
    }
  }

  .nsc-hero-media-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    position: absolute;
    top: 0;
    left: 0;
  }

  .nsc-hero-media-placeholder {
    padding: 24px;
    z-index: 1;
    color: rgba(255, 255, 255, 0.45);
  }

  .nsc-hero-media-placeholder strong {
    display: block;
    color: rgba(255, 255, 255, 0.75);
    font-size: 16px;
    margin-bottom: 6px;
  }
{% endstyle %}

<div class="nsc-hero-corporate-{{ section.id }}">
  <div class="nsc-hero-container">
    <div class="nsc-hero-content">
      <h1 class="nsc-hero-headline">
        Bold<br>
        flavour.<br>
        Nothing to<br>
        hide.
      </h1>
      <p class="nsc-hero-subtext">
        Clean-label sauces, free from the major allergens and made with real ingredients only.
      </p>
      <div class="nsc-hero-actions">
        <a href="#dialShowcase" class="nsc-btn-primary">See our sauces</a>
        <a href="/pages/contact" class="nsc-btn-secondary">Talk to the team</a>
      </div>
    </div>

    <div class="nsc-hero-media-wrap">
      {% if section.settings.image != blank %}
        <img
          src="{{ section.settings.image | image_url: width: 900 }}"
          alt="{{ section.settings.image.alt | default: 'The Naked Sauce Co Chef' }}"
          class="nsc-hero-media-img"
          loading="eager"
        >
      {% else %}
        <div class="nsc-hero-media-placeholder">
          <strong>Chef image</strong>
          <span>Existing photo goes here</span>
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Corporate Landing Hero",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Chef / Hero Image"
    }
  ],
  "presets": [
    {
      "name": "Corporate Landing Hero"
    }
  ]
}
{% endschema %}
