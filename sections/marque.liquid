{% style %}
  .marquee-bar-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#DA6634' }};
    color: #ffffff;
    padding: 16px 0;
    overflow: hidden;
    white-space: nowrap;
    position: relative;
    border-top: none;
    border-bottom: none;
    /* Clean straight solid bar — no wavy dividers */
  }

  .marquee-bar-{{ section.id }} .marquee-track {
    display: inline-flex;
    align-items: center;
    animation: marqueeScroll {{ section.settings.speed | default: 28 }}s linear infinite;
    will-change: transform;
  }

  .marquee-bar-{{ section.id }} .marquee-track:hover {
    animation-play-state: paused;
  }

  .marquee-bar-{{ section.id }} .marquee-item {
    display: inline-flex;
    align-items: center;
    font-size: clamp(14px, 1.2vw, 17px);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0 24px;
    color: #ffffff;
  }

  /* Naked Sauce Co brand logo separator */
  .marquee-bar-{{ section.id }} .marquee-separator-logo {
    height: 20px;
    width: auto;
    object-fit: contain;
    margin-left: 24px;
    display: inline-block;
    filter: brightness(0) invert(1); /* Pure white brand logo on orange bar */
    opacity: 0.95;
  }

  @keyframes marqueeScroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
{% endstyle %}

<div class="marquee-bar-{{ section.id }}" aria-hidden="true">
  <div class="marquee-track">
    {% capture marquee_content %}
      <span class="marquee-item">
        Clean label
        {% if settings.logo != blank %}
          <img src="{{ settings.logo | image_url: width: 80 }}" alt="" class="marquee-separator-logo">
        {% else %}
          <span style="margin-left: 24px; opacity: 0.7;">•</span>
        {% endif %}
      </span>
      <span class="marquee-item">
        Free from major allergens
        {% if settings.logo != blank %}
          <img src="{{ settings.logo | image_url: width: 80 }}" alt="" class="marquee-separator-logo">
        {% else %}
          <span style="margin-left: 24px; opacity: 0.7;">•</span>
        {% endif %}
      </span>
      <span class="marquee-item">
        Zero ultra-processed ingredients
        {% if settings.logo != blank %}
          <img src="{{ settings.logo | image_url: width: 80 }}" alt="" class="marquee-separator-logo">
        {% else %}
          <span style="margin-left: 24px; opacity: 0.7;">•</span>
        {% endif %}
      </span>
      <span class="marquee-item">
        Real natural ingredients
        {% if settings.logo != blank %}
          <img src="{{ settings.logo | image_url: width: 80 }}" alt="" class="marquee-separator-logo">
        {% else %}
          <span style="margin-left: 24px; opacity: 0.7;">•</span>
        {% endif %}
      </span>
      <span class="marquee-item">
        Bold flavour, nothing to hide
        {% if settings.logo != blank %}
          <img src="{{ settings.logo | image_url: width: 80 }}" alt="" class="marquee-separator-logo">
        {% else %}
          <span style="margin-left: 24px; opacity: 0.7;">•</span>
        {% endif %}
      </span>
    {% endcapture %}

    <!-- Repeated twice to guarantee seamless infinite loop -->
    {{ marquee_content }}
    {{ marquee_content }}
  </div>
</div>

{% schema %}
{
  "name": "Scrolling Banner",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#DA6634"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "s",
      "label": "Scroll duration (lower is faster)",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "Scrolling Banner"
    }
  ]
}
{% endschema %}
