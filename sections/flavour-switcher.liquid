{% schema %}
{
  "name": "Flavour Dial Showcase",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "preheading", "label": "Preheading", "default": "Explore The Range" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "15 sauces. Three ranges. One standard." },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>Naturally allergen-free. Made without ultra-processed ingredients. Click any sauce to reveal flavour pairings and menu applications.</p>" },
    { "type": "select", "id": "heading_tag", "options": [
        { "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" }
      ], "default": "h2", "label": "Heading tag" },
    { "type": "select", "id": "heading_size", "options": [
        { "value": "h1", "label": "H1" }, { "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" }
      ], "default": "h2", "label": "Heading size" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#DA6634" },
    { "type": "color", "id": "panel_bg", "label": "Stage Card Background", "default": "#2A2620" },
    { "type": "color", "id": "bg_color", "label": "Section Background", "default": "#231F1A" },
    { "type": "color", "id": "text_color", "label": "Heading Text Color", "default": "#FBF3E4" },
    { "type": "color", "id": "muted_text_color", "label": "Description Text Color", "default": "#D6CDBF" }
  ],
  "blocks": [
    {
      "type": "flavour",
      "name": "Flavour SKU",
      "settings": [
        { "type": "text", "id": "name", "label": "Sauce name", "default": "Sauce Name" },
        {
          "type": "select",
          "id": "range_category",
          "label": "Range Category",
          "options": [
            { "value": "Table Sauces", "label": "Table Sauces" },
            { "value": "Cooking Sauces", "label": "Cooking Sauces" },
            { "value": "Base Sauces", "label": "Kitchen Base Sauces" }
          ],
          "default": "Table Sauces"
        },
        { "type": "textarea", "id": "description", "label": "Serving suggestion & Menu use", "default": "Serving suggestion goes here." },
        { "type": "color", "id": "color", "label": "Swatch accent color", "default": "#C13B2A" },
        { "type": "image_picker", "id": "image", "label": "Sauce Bottle / Dish Photography" }
      ]
    }
  ]
}
{% endschema %}
