{% style %}
  .flavour-switcher-{{ section.id }} {
    --fs-accent: {{ section.settings.accent_color | default: '#DA6634' }};
    --fs-text-main: {{ section.settings.text_color | default: '#FBF3E4' }};
    --fs-text-muted: {{ section.settings.muted_text_color | default: '#D6CDBF' }};
    --fs-panel-bg: {{ section.settings.panel_bg | default: '#2A2620' }};
  }

  .flavour-switcher-{{ section.id }} .cs-section-header * {
    color: var(--fs-text-main) !important;
  }

  /* Range Category Filter Pills */
  .flavour-switcher-{{ section.id }} .fs-filter-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 24px;
  }

  .flavour-switcher-{{ section.id }} .fs-filter-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--fs-text-muted);
    border-radius: 50px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .flavour-switcher-{{ section.id }} .fs-filter-btn:hover {
    color: var(--fs-text-main);
    border-color: rgba(255, 255, 255, 0.25);
  }

  .flavour-switcher-{{ section.id }} .fs-filter-btn.active {
    background: var(--fs-accent);
    color: #ffffff;
    border-color: var(--fs-accent);
  }

  /* Main Interactive Grid */
  .flavour-switcher-{{ section.id }} .fs-shell {
    display: grid;
    grid-template-columns: 340px 1fr;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    overflow: hidden;
    background: var(--fs-panel-bg);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
  }

  @media (max-width: 900px) {
    .flavour-switcher-{{ section.id }} .fs-shell {
      grid-template-columns: 1fr;
    }
  }

  /* Left Menu Tabs */
  .flavour-switcher-{{ section.id }} .fs-tabs {
    display: flex;
    flex-direction: column;
    max-height: 480px;
    overflow-y: auto;
    background: rgba(0, 0, 0, 0.2);
    border-right: 1px solid rgba(255, 255, 255, 0.08);
  }

  .flavour-switcher-{{ section.id }} .fs-tab {
    display: flex;
    align-items: center;
    gap: 12px;
    text-align: left;
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    border-left: 3px solid transparent;
    cursor: pointer;
    padding: 14px 20px;
    font-size: 14px;
    color: var(--fs-text-muted);
    transition: all 0.15s ease;
  }

  .flavour-switcher-{{ section.id }} .fs-tab:hover {
    background: rgba(255, 255, 255, 0.04);
    color: var(--fs-text-main);
  }

  .flavour-switcher-{{ section.id }} .fs-tab.active {
    background: rgba(255, 255, 255, 0.08);
    color: var(--fs-text-main);
    font-weight: 700;
    border-left-color: var(--fs-accent);
  }

  .flavour-switcher-{{ section.id }} .fs-tab-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    flex-shrink: 0;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.2);
  }

  .flavour-switcher-{{ section.id }} .fs-tab-text {
    flex-grow: 1;
    line-height: 1.3;
  }

  .flavour-switcher-{{ section.id }} .fs-tab-range {
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.55;
    display: block;
    margin-top: 2px;
  }

  /* Right Showcase Panel */
  .flavour-switcher-{{ section.id }} .fs-panel {
    padding: 48px 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: var(--fs-panel-bg);
  }

  @media (max-width: 600px) {
    .flavour-switcher-{{ section.id }} .fs-panel {
      padding: 32px 24px;
    }
  }

  .flavour-switcher-{{ section.id }} .fs-panel-range-badge {
    display: inline-block;
    align-self: flex-start;
    padding: 4px 12px;
    border-radius: 50px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fs-accent);
    margin-bottom: 16px;
  }

  .flavour-switcher-{{ section.id }} .fs-header-row {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 16px;
  }

  .flavour-switcher-{{ section.id }} .fs-swatch {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    flex-shrink: 0;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.4), inset 0 0 0 2px rgba(255, 255, 255, 0.25);
    transition: background 0.25s ease;
  }

  .flavour-switcher-{{ section.id }} .fs-name {
    font-size: clamp(24px, 3.2vw, 36px);
    font-weight: 800;
    line-height: 1.15;
    margin: 0;
    color: var(--fs-text-main) !important;
  }

  .flavour-switcher-{{ section.id }} .fs-desc {
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--fs-text-muted) !important;
    max-width: 55ch;
    margin: 0 0 28px;
  }

  .flavour-switcher-{{ section.id }} .fs-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .flavour-switcher-{{ section.id }} .fs-cta-btn {
    display: inline-flex;
    align-items: center;
    background: var(--fs-accent);
    color: #ffffff;
    text-decoration: none;
    font-size: 12.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 10px 22px;
    border-radius: 50px;
    transition: opacity 0.2s ease, transform 0.15s ease;
  }

  .flavour-switcher-{{ section.id }} .fs-cta-btn:hover {
    opacity: 0.9;
    transform: scale(0.98);
  }

  .flavour-switcher-{{ section.id }} .fs-badge-tag {
    font-size: 12px;
    color: var(--fs-text-muted);
    opacity: 0.75;
  }
{% endstyle %}

<div class="flavour-switcher-{{ section.id }} section-{{ section.id }}-padding container page-width" style="background:{{ section.settings.bg_color | default: 'transparent' }};">
  <div class="cs-section-header text-start" style="margin-bottom: 28px;">
    {% render 'heading',
      heading: section.settings.heading,
      heading_tag: section.settings.heading_tag,
      heading_size: section.settings.heading_size,
      preheading: section.settings.preheading,
      subheading: section.settings.subheading
    %}
  </div>

  <!-- Category Filter Pills -->
  <div class="fs-filter-nav" role="tablist">
    <button type="button" class="fs-filter-btn active" data-filter="all">All 15 Sauces</button>
    <button type="button" class="fs-filter-btn" data-filter="Table Sauces">Table Sauces</button>
    <button type="button" class="fs-filter-btn" data-filter="Cooking Sauces">Cooking Sauces</button>
    <button type="button" class="fs-filter-btn" data-filter="Base Sauces">Kitchen Bases</button>
  </div>

  <div class="fs-shell">
    <!-- Left SKU Selection List -->
    <div class="fs-tabs" role="tablist">
      {% for block in section.blocks %}
        <button
          type="button"
          class="fs-tab{% if forloop.first %} active{% endif %}"
          data-i="{{ forloop.index0 }}"
          data-range="{{ block.settings.range_category | default: 'Table Sauces' }}"
          {{ block.shopify_attributes }}
        >
          <span class="fs-tab-dot" style="background-color: {{ block.settings.color }};"></span>
          <span class="fs-tab-text">
            {{ block.settings.name }}
            <span class="fs-tab-range">{{ block.settings.range_category | default: 'Sauce' }}</span>
          </span>
        </button>
      {% endfor %}
    </div>

    <!-- Right Featured Panel -->
    <div class="fs-panel">
      <span class="fs-panel-range-badge">Table Sauces</span>
      <div class="fs-header-row">
        <div class="fs-swatch"></div>
        <h3 class="fs-name"></h3>
      </div>
      <p class="fs-desc"></p>

      <div class="fs-actions">
        <a href="/pages/contact?subject=Trade%20Enquiry%20-%20The%20Range" class="fs-cta-btn">
          Request Specs / Quote
        </a>
        <span class="fs-badge-tag">Free from 14 major allergens • UPF-free</span>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.currentScript.previousElementSibling;
    var data = [
      {% for block in section.blocks %}
        {
          name: {{ block.settings.name | json }},
          desc: {{ block.settings.description | json }},
          color: {{ block.settings.color | json }},
          range: {{ block.settings.range_category | default: 'Table Sauces' | json }}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ];

    var tabs = root.querySelectorAll('.fs-tab');
    var filterBtns = root.querySelectorAll('.fs-filter-btn');
    var swatch = root.querySelector('.fs-swatch');
    var nameEl = root.querySelector('.fs-name');
    var descEl = root.querySelector('.fs-desc');
    var badgeEl = root.querySelector('.fs-panel-range-badge');

    function setFlavour(i) {
      var item = data[i];
      if (!item) return;

      nameEl.style.opacity = '0';
      descEl.style.opacity = '0';

      setTimeout(function () {
        nameEl.textContent = item.name;
        descEl.textContent = item.desc;
        badgeEl.textContent = item.range;
        swatch.style.background = item.color;
        nameEl.style.opacity = '1';
        descEl.style.opacity = '1';
      }, 100);
    }

    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        tabs.forEach(function (t) { t.classList.remove('active'); });
        tab.classList.add('active');
        setFlavour(parseInt(tab.dataset.i, 10));
      });
    });

    // Category Filtering Functionality
    filterBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        filterBtns.forEach(function (b) { b.classList.remove('active'); });
        btn.classList.add('active');

        var filter = btn.dataset.filter;
        var firstVisibleIndex = null;

        tabs.forEach(function (tab) {
          var itemRange = tab.dataset.range;
          if (filter === 'all' || itemRange === filter) {
            tab.style.display = 'flex';
            if (firstVisibleIndex === null) {
              firstVisibleIndex = parseInt(tab.dataset.i, 10);
            }
          } else {
            tab.style.display = 'none';
          }
        });

        if (firstVisibleIndex !== null) {
          tabs.forEach(function (t) { t.classList.remove('active'); });
          var activeTab = root.querySelector('.fs-tab[data-i="' + firstVisibleIndex + '"]');
          if (activeTab) activeTab.classList.add('active');
          setFlavour(firstVisibleIndex);
        }
      });
    });

    if (data.length) setFlavour(0);
  })();
</script>

{% schema %}
{
  "name": "Flavour switcher",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "preheading", "label": "Preheading", "default": "The Range" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "15 sauces. Three ranges. One allergen-free standard." },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>Select any range or sauce to explore flavour profiles, allergen credentials, and foodservice serving suggestions.</p>" },
    { "type": "select", "id": "heading_tag", "options": [
        { "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" }
      ], "default": "h2", "label": "Heading tag" },
    { "type": "select", "id": "heading_size", "options": [
        { "value": "h1", "label": "H1" }, { "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" }
      ], "default": "h2", "label": "Heading size" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#DA6634" },
    { "type": "color", "id": "panel_bg", "label": "Panel background", "default": "#2A2620" },
    { "type": "color", "id": "bg_color", "label": "Section background", "default": "#231F1A" },
    { "type": "color", "id": "text_color", "label": "Heading & active text color", "default": "#FBF3E4" },
    { "type": "color", "id": "muted_text_color", "label": "Description & tab text color", "default": "#D6CDBF" }
  ],
  "blocks": [
    {
      "type": "flavour",
      "name": "Flavour SKU",
      "settings": [
        { "type": "text", "id": "name", "label": "Sauce name", "default": "Sauce Name" },
        {
          "type": "select",
          "id": "range_category",
          "label": "Range Category",
          "options": [
            { "value": "Table Sauces", "label": "Table Sauces" },
            { "value": "Cooking Sauces", "label": "Cooking Sauces" },
            { "value": "Base Sauces", "label": "Kitchen Base Sauces" }
          ],
          "default": "Table Sauces"
        },
        { "type": "textarea", "id": "description", "label": "Serving suggestion & Menu use", "default": "Serving suggestion goes here." },
        { "type": "color", "id": "color", "label": "Swatch accent color", "default": "#C13B2A" }
      ]
    }
  ]
}
{% endschema %}
