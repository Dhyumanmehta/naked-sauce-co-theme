{%- liquid
  assign collection_table = section.settings.collection_table | default: collections['table-sauces']
  assign collection_cooking = section.settings.collection_cooking | default: collections['cooking-sauces']
-%}

{% style %}
  .dial-showcase-{{ section.id }} {
    --ds-accent: {{ section.settings.accent_color | default: '#DA6634' }};
    --ds-bg: #1e1e1e;
    --ds-card-bg: #DA6634;
    --ds-text: #ffffff;
    --ds-muted: rgba(255, 255, 255, 0.75);
    background-color: var(--ds-bg);
    color: var(--ds-text);
    position: relative;
    overflow: hidden;
    padding-top: 70px;
    padding-bottom: 80px;
  }

  .dial-showcase-{{ section.id }} .ds-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 32px;
    position: relative;
    z-index: 2;
  }

  /* Side-by-side Header layout */
  .dial-showcase-{{ section.id }} .ds-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 36px;
    gap: 30px;
    flex-wrap: wrap;
  }

  .dial-showcase-{{ section.id }} .ds-header-title {
    font-size: clamp(38px, 4.5vw, 56px);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin: 0;
  }

  .dial-showcase-{{ section.id }} .ds-header-sub {
    font-size: clamp(15px, 1.2vw, 18px);
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
    max-width: 480px;
    text-align: right;
  }

  @media (max-width: 768px) {
    .dial-showcase-{{ section.id }} .ds-header-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
    .dial-showcase-{{ section.id }} .ds-header-sub {
      text-align: left;
    }
  }

  .dial-showcase-{{ section.id }} .ds-nav {
    display: flex;
    justify-content: flex-start;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }

  .dial-showcase-{{ section.id }} .ds-filter-pill {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: rgba(255, 255, 255, 0.85);
    border-radius: 50px;
    padding: 8px 20px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .dial-showcase-{{ section.id }} .ds-filter-pill:hover {
    border-color: #ffffff;
    color: #ffffff;
  }

  .dial-showcase-{{ section.id }} .ds-filter-pill.active {
    background: #DA6634;
    border-color: #DA6634;
    color: #ffffff;
  }

  .dial-showcase-{{ section.id }} .ds-dial-carousel {
    display: flex;
    gap: 14px;
    overflow-x: auto;
    padding: 8px 0 24px;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .dial-showcase-{{ section.id }} .ds-dial-carousel::-webkit-scrollbar {
    display: none;
  }

  .dial-showcase-{{ section.id }} .ds-swatch-node {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 6px 10px;
    opacity: 0.55;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .dial-showcase-{{ section.id }} .ds-swatch-node:hover,
  .dial-showcase-{{ section.id }} .ds-swatch-node.active {
    opacity: 1;
    transform: translateY(-4px);
  }

  .dial-showcase-{{ section.id }} .ds-node-circle {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 2px solid rgba(255,255,255,0.2);
  }

  .dial-showcase-{{ section.id }} .ds-swatch-node.active .ds-node-circle {
    border-color: #ffffff;
    box-shadow: 0 0 0 2px #DA6634;
  }

  .dial-showcase-{{ section.id }} .ds-node-label {
    font-size: 11px;
    font-weight: 600;
    max-width: 95px;
    text-align: center;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .dial-showcase-{{ section.id }} .ds-stage {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 40px;
    background: #DA6634;
    border-radius: 16px;
    padding: 48px;
    align-items: center;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
  }

  @media (max-width: 900px) {
    .dial-showcase-{{ section.id }} .ds-stage {
      grid-template-columns: 1fr;
      padding: 30px 20px;
    }
  }

  .dial-showcase-{{ section.id }} .ds-stage-visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 280px;
  }

  .dial-showcase-{{ section.id }} .ds-orb {
    width: 220px;
    height: 220px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.15);
    position: absolute;
    z-index: 1;
  }

  .dial-showcase-{{ section.id }} .ds-bottle-img {
    height: 280px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    position: relative;
    z-index: 2;
  }

  .dial-showcase-{{ section.id }} .ds-range-tag {
    display: inline-block;
    padding: 4px 14px;
    border-radius: 50px;
    background: rgba(0, 0, 0, 0.2);
    color: #ffffff;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 14px;
  }

  .dial-showcase-{{ section.id }} .ds-title {
    font-size: clamp(28px, 3.2vw, 42px);
    font-weight: 900;
    line-height: 1.1;
    margin: 0 0 14px;
    color: #ffffff !important;
  }

  .dial-showcase-{{ section.id }} .ds-desc {
    font-size: 16px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.9) !important;
    margin: 0 0 24px;
  }

  .dial-showcase-{{ section.id }} .ds-formats-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }

  .dial-showcase-{{ section.id }} .ds-format-chip {
    background: rgba(0, 0, 0, 0.2);
    border-radius: 4px;
    padding: 5px 12px;
    font-size: 12px;
    color: #ffffff;
    font-weight: 600;
  }

  .dial-showcase-{{ section.id }} .ds-btn {
    background: #ffffff;
    color: #231F1A !important;
    border-radius: 4px;
    padding: 12px 26px;
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
    text-decoration: none;
    display: inline-block;
  }
{% endstyle %}

<div class="dial-showcase-{{ section.id }}" id="our-sauces">
  <div class="ds-inner">
    <div class="ds-header-row">
      <h2 class="ds-header-title">Our sauces</h2>
      <p class="ds-header-sub">A complete range of table and cooking sauces. One standard.</p>
    </div>

    <!-- Clean tabs: No blank tab button -->
    <div class="ds-nav" role="tablist">
      {% if collection_table != blank and collection_table.products_count > 0 %}
        <button type="button" class="ds-filter-pill active" data-filter="table">{{ collection_table.title }} ({{ collection_table.products_count }})</button>
      {% else %}
        <button type="button" class="ds-filter-pill active" data-filter="table">Table Sauces (7)</button>
      {% endif %}
      
      {% if collection_cooking != blank and collection_cooking.products_count > 0 %}
        <button type="button" class="ds-filter-pill" data-filter="cooking">{{ collection_cooking.title }} ({{ collection_cooking.products_count }})</button>
      {% else %}
        <button type="button" class="ds-filter-pill" data-filter="cooking">Cooking Sauces (6)</button>
      {% endif %}
    </div>

    <!-- Swatch carousel -->
    <div class="ds-dial-carousel" id="dsCarousel">
      {% assign global_idx = 0 %}
      {% if collection_table != blank %}
        {% for product in collection_table.products %}
          <button type="button" class="ds-swatch-node{% if global_idx == 0 %} active{% endif %}" data-i="{{ global_idx }}" data-range="table">
            <div class="ds-node-circle" style="background-color: #DA6634;"></div>
            <span class="ds-node-label">{{ product.title }}</span>
          </button>
          {% assign global_idx = global_idx | plus: 1 %}
        {% endfor %}
      {% endif %}

      {% if collection_cooking != blank %}
        {% for product in collection_cooking.products %}
          <button type="button" class="ds-swatch-node{% if global_idx == 0 %} active{% endif %}" data-i="{{ global_idx }}" data-range="cooking">
            <div class="ds-node-circle" style="background-color: #A3281B;"></div>
            <span class="ds-node-label">{{ product.title }}</span>
          </button>
          {% assign global_idx = global_idx | plus: 1 %}
        {% endfor %}
      {% endif %}
    </div>

    <!-- Spotlight card -->
    <div class="ds-stage">
      <div class="ds-stage-visual">
        <div class="ds-orb"></div>
        <img id="dsBottleImg" class="ds-bottle-img" src="" alt="Sauce bottle" style="display: none;">
      </div>

      <div class="ds-stage-info">
        <span class="ds-range-tag" id="dsRangeTag">Table Sauces</span>
        <h3 class="ds-title" id="dsTitle"></h3>
        <p class="ds-desc" id="dsDesc"></p>

        <div class="ds-formats-row">
          <span style="font-size:12px; font-weight:700; color:#fff; margin-right:4px;">Available in:</span>
          <span class="ds-format-chip">Sachets</span>
          <span class="ds-format-chip">Table bottles</span>
          <span class="ds-format-chip">Tubs</span>
        </div>

        <p style="font-size: 13px; color: rgba(255,255,255,0.85); margin-bottom: 20px;">
          Every sauce comes in the formats that suit your kitchen or shelf.
        </p>

        <a href="#contact" class="ds-btn" id="dsQuoteBtn">Talk to the team</a>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    function initDialShowcase() {
      var root = document.querySelector('#our-sauces');
      if (!root) return;

      var rawData = [
        {% assign is_first = true %}
        {% if collection_table != blank %}
          {% for product in collection_table.products %}
            {% unless is_first %},{% endunless %}
            {
              name: {{ product.title | json }},
              desc: {{ product.description | strip_html | truncatewords: 24 | default: 'Bold flavour, nothing to hide. Universally safe for every table.' | json }},
              range_slug: "table",
              range_label: "Table Sauces",
              image: {% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 600 | json }}{% else %}""{% endif %}
            }
            {% assign is_first = false %}
          {% endfor %}
        {% endif %}
        {% if collection_cooking != blank %}
          {% for product in collection_cooking.products %}
            {% unless is_first %},{% endunless %}
            {
              name: {{ product.title | json }},
              desc: {{ product.description | strip_html | truncatewords: 24 | default: 'Chef-developed cooking sauce and glaze designed for maximum menu versatility.' | json }},
              range_slug: "cooking",
              range_label: "Cooking Sauces",
              image: {% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 600 | json }}{% else %}""{% endif %}
            }
            {% assign is_first = false %}
          {% endfor %}
        {% endif %}
      ];

      var nodes = root.querySelectorAll('.ds-swatch-node');
      var filterBtns = root.querySelectorAll('.ds-filter-pill');
      var bottleImg = root.querySelector('#dsBottleImg');
      var titleEl = root.querySelector('#dsTitle');
      var descEl = root.querySelector('#dsDesc');
      var rangeTagEl = root.querySelector('#dsRangeTag');

      function setActiveSauce(i) {
        var item = rawData[i];
        if (!item) return;

        if (titleEl) titleEl.textContent = item.name;
        if (descEl) descEl.textContent = item.desc;
        if (rangeTagEl) rangeTagEl.textContent = item.range_label;

        if (bottleImg) {
          if (item.image && item.image !== '') {
            bottleImg.src = item.image;
            bottleImg.style.display = 'block';
          } else {
            bottleImg.style.display = 'none';
          }
        }

        nodes.forEach(function (n) { n.classList.remove('active'); });
        var activeNode = root.querySelector('.ds-swatch-node[data-i="' + i + '"]');
        if (activeNode) activeNode.classList.add('active');
      }

      nodes.forEach(function (node) {
        node.addEventListener('click', function () {
          setActiveSauce(parseInt(node.dataset.i, 10));
        });
      });

      filterBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          filterBtns.forEach(function (b) { b.classList.remove('active'); });
          btn.classList.add('active');
          var filter = btn.dataset.filter;
          var firstMatch = null;

          nodes.forEach(function (node) {
            if (node.dataset.range === filter) {
              node.style.display = 'flex';
              if (firstMatch === null) firstMatch = parseInt(node.dataset.i, 10);
            } else {
              node.style.display = 'none';
            }
          });

          if (firstMatch !== null) setActiveSauce(firstMatch);
        });
      });

      var initialBtn = root.querySelector('.ds-filter-pill.active');
      if (initialBtn) initialBtn.click();
      else if (rawData.length) setActiveSauce(0);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initDialShowcase);
    } else {
      initDialShowcase();
    }
  })();
</script>

{% schema %}
{
  "name": "Flavour Dial Showcase",
  "tag": "section",
  "settings": [
    { "type": "collection", "id": "collection_table", "label": "Table Sauces Collection" },
    { "type": "collection", "id": "collection_cooking", "label": "Cooking Sauces Collection" }
  ],
  "presets": [
    { "name": "Flavour Dial Showcase" }
  ]
}
{% endschema %}
