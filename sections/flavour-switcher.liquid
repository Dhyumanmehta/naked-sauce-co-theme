<script>
  (function () {
    function initDialShowcase() {
      var root = document.querySelector('#dialShowcase-{{ section.id }}');
      if (!root) return;

      var data = [
        {% for block in section.blocks %}
          {
            name: {{ block.settings.name | json }},
            desc: {{ block.settings.description | json }},
            color: {{ block.settings.color | json }},
            range: {{ block.settings.range_category | default: 'Table Sauces' | json }},
            image: {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 600 | json }}{% else %}""{% endif %}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ];

      var nodes = root.querySelectorAll('.ds-swatch-node');
      var filterBtns = root.querySelectorAll('.ds-filter-pill');
      var carousel = root.querySelector('#dsCarousel');
      var orb = root.querySelector('#dsOrb');
      var bottleImg = root.querySelector('#dsBottleImg');
      var orbBadge = root.querySelector('#dsOrbBadge');
      var glow = root.querySelector('#dsAmbientGlow');
      var titleEl = root.querySelector('#dsTitle');
      var descEl = root.querySelector('#dsDesc');
      var rangeTagEl = root.querySelector('#dsRangeTag');
      var quoteBtn = root.querySelector('#dsQuoteBtn');

      var currentIndex = 0;
      var autoPlayTimer = null;
      var isPaused = false;

      function scrollNodeIntoView(node) {
        if (!carousel || !node) return;
        var carouselRect = carousel.getBoundingClientRect();
        var nodeRect = node.getBoundingClientRect();
        var scrollOffset = (nodeRect.left - carouselRect.left) - (carouselRect.width / 2) + (nodeRect.width / 2);
        carousel.scrollBy({ left: scrollOffset, behavior: 'smooth' });
      }

      function setActiveSauce(i) {
        var item = data[i];
        if (!item) return;

        currentIndex = i;

        if (titleEl) {
          titleEl.style.opacity = '0';
          titleEl.style.transform = 'translateY(6px)';
        }
        if (descEl) descEl.style.opacity = '0';
        if (bottleImg) bottleImg.style.opacity = '0';

        setTimeout(function () {
          if (titleEl) {
            titleEl.textContent = item.name;
            titleEl.style.opacity = '1';
            titleEl.style.transform = 'translateY(0)';
          }
          if (descEl) {
            descEl.textContent = item.desc;
            descEl.style.opacity = '1';
          }
          if (rangeTagEl) rangeTagEl.textContent = item.range;
          if (orb) orb.style.backgroundColor = item.color;
          if (glow) glow.style.background = 'radial-gradient(circle, ' + item.color + ' 0%, transparent 68%)';
          if (quoteBtn) quoteBtn.href = '/pages/contact?subject=Quote%20Request%20-%20' + encodeURIComponent(item.name);

          if (bottleImg && orbBadge) {
            if (item.image && item.image !== '') {
              bottleImg.src = item.image;
              bottleImg.style.display = 'block';
              bottleImg.style.opacity = '1';
              orbBadge.style.display = 'none';
            } else {
              bottleImg.style.display = 'none';
              orbBadge.style.display = 'block';
            }
          }
        }, 120);

        nodes.forEach(function (n) { n.classList.remove('active'); });
        var activeNode = root.querySelector('.ds-swatch-node[data-i="' + i + '"]');
        if (activeNode) {
          activeNode.classList.add('active');
          scrollNodeIntoView(activeNode);
        }
      }

      function getVisibleIndices() {
        var visible = [];
        nodes.forEach(function (node) {
          if (window.getComputedStyle(node).display !== 'none') {
            visible.push(parseInt(node.dataset.i, 10));
          }
        });
        return visible;
      }

      function nextSauce() {
        if (isPaused) return;
        var visible = getVisibleIndices();
        if (!visible.length) return;

        var currentPos = visible.indexOf(currentIndex);
        var nextPos = (currentPos + 1) % visible.length;
        setActiveSauce(visible[nextPos]);
      }

      function startAutoPlay() {
        stopAutoPlay();
        autoPlayTimer = setInterval(nextSauce, 3500);
      }

      function stopAutoPlay() {
        if (autoPlayTimer) {
          clearInterval(autoPlayTimer);
          autoPlayTimer = null;
        }
      }

      // Manual clicks on swatches
      nodes.forEach(function (node) {
        node.addEventListener('click', function () {
          var idx = parseInt(node.dataset.i, 10);
          setActiveSauce(idx);
          startAutoPlay();
        });
      });

      // Filter tabs click
      filterBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          filterBtns.forEach(function (b) { b.classList.remove('active'); });
          btn.classList.add('active');

          var filter = btn.dataset.filter;
          var firstMatch = null;

          nodes.forEach(function (node) {
            var range = node.dataset.range;
            if (filter === 'all' || range === filter) {
              node.style.display = 'flex';
              if (firstMatch === null) {
                firstMatch = parseInt(node.dataset.i, 10);
              }
            } else {
              node.style.display = 'none';
            }
          });

          if (firstMatch !== null) {
            setActiveSauce(firstMatch);
          }
          startAutoPlay();
        });
      });

      // Pause only while user holds mouse over carousel, resume immediately on exit
      carousel.addEventListener('mouseenter', function () { isPaused = true; });
      carousel.addEventListener('mouseleave', function () { isPaused = false; });
      carousel.addEventListener('touchstart', function () { isPaused = true; }, { passive: true });
      carousel.addEventListener('touchend', function () {
        setTimeout(function () { isPaused = false; }, 2000);
      });

      // Initialize
      if (data.length) {
        setActiveSauce(0);
        startAutoPlay();
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initDialShowcase);
    } else {
      initDialShowcase();
    }

    // Shopify theme customizer live reload handler
    document.addEventListener('shopify:section:load', function (e) {
      if (e.target && e.target.querySelector('#dialShowcase-{{ section.id }}')) {
        initDialShowcase();
      }
    });
  })();
</script>

<div class="dial-showcase-{{ section.id }}" id="dialShowcase-{{ section.id }}">
  <div class="ds-ambient-glow" id="dsAmbientGlow"></div>

  <div class="ds-inner container page-width">
    <!-- Header -->
    <div class="cs-section-header text-center mb-4">
      {% render 'heading',
        heading: section.settings.heading,
        heading_tag: section.settings.heading_tag,
        heading_size: section.settings.heading_size,
        preheading: section.settings.preheading,
        subheading: section.settings.subheading
      %}
    </div>

    <!-- Category Pills -->
    <div class="ds-nav" role="tablist">
      <button type="button" class="ds-filter-pill active" data-filter="all">All 15 Sauces</button>
      <button type="button" class="ds-filter-pill" data-filter="Table Sauces">Table Sauces (6)</button>
      <button type="button" class="ds-filter-pill" data-filter="Cooking Sauces">Cooking Sauces (6)</button>
      <button type="button" class="ds-filter-pill" data-filter="Base Sauces">Kitchen Bases (3)</button>
    </div>

    <!-- Swatch Nodes Ribbon -->
    <div class="ds-dial-carousel" id="dsCarousel">
      {% for block in section.blocks %}
        <button
          type="button"
          class="ds-swatch-node{% if forloop.first %} active{% endif %}"
          data-i="{{ forloop.index0 }}"
          data-range="{{ block.settings.range_category | default: 'Table Sauces' }}"
          {{ block.shopify_attributes }}
        >
          <div class="ds-node-circle" style="background-color: {{ block.settings.color }};"></div>
          <span class="ds-node-label">{{ block.settings.name }}</span>
        </button>
      {% endfor %}
    </div>

    <!-- Spotlight Stage Card -->
    <div class="ds-stage">
      <div class="ds-stage-visual">
        <div class="ds-orb" id="dsOrb"></div>
        <img id="dsBottleImg" class="ds-bottle-img" src="" alt="Sauce bottle" style="display: none;">
        <div class="ds-orb-badge" id="dsOrbBadge">100% UPF-FREE</div>
      </div>

      <div class="ds-stage-info">
        <span class="ds-range-tag" id="dsRangeTag">Table Sauces</span>
        <h3 class="ds-title" id="dsTitle"></h3>
        <p class="ds-desc" id="dsDesc"></p>

        <div class="ds-formats-row">
          <span class="small opacity-75 pe-1" style="font-size:11px; text-transform:uppercase; letter-spacing:0.06em;">Formats:</span>
          <span class="ds-format-chip">Sachets</span>
          <span class="ds-format-chip">Table Bottles</span>
          <span class="ds-format-chip">Tubs / Pails</span>
          <span class="ds-format-chip">Bag-in-Box</span>
        </div>

        <div class="ds-actions">
          <a href="/pages/contact?subject=Sample%20Request%20-%20The%20Range" class="ds-btn" id="dsQuoteBtn">
            Request Spec & Quote
          </a>
          <span class="ds-safe-stamp">
            ✓ 14 Major Allergens Free & NOVA UPF-Free
          </span>
        </div>
      </div>
    </div>
  </div>
</div>

