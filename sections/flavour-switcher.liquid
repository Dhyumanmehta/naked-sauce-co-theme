{%- liquid
  assign collection_table = section.settings.collection_table | default: collections['table-sauces']
  assign collection_cooking = section.settings.collection_cooking | default: collections['cooking-sauces']
-%}

{% style %}
  .dial-showcase-{{ section.id }} {
    --ds-accent: {{ section.settings.accent_color | default: '#DA6634' }};
    --ds-bg: #1A1715;
    background-color: var(--ds-bg);
    color: #ffffff;
    position: relative;
    overflow: hidden;
    padding-top: 70px;
    padding-bottom: 90px;
  }

  .dial-showcase-{{ section.id }} .ds-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 32px;
    position: relative;
    z-index: 2;
  }

  .dial-showcase-{{ section.id }} .ds-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 32px;
    gap: 30px;
    flex-wrap: wrap;
  }

  .dial-showcase-{{ section.id }} .ds-header-title {
    font-size: clamp(38px, 4.5vw, 56px);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin: 0;
  }

  .dial-showcase-{{ section.id }} .ds-header-sub {
    font-size: clamp(15px, 1.2vw, 18px);
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
    max-width: 480px;
    text-align: right;
  }

  @media (max-width: 768px) {
    .dial-showcase-{{ section.id }} .ds-header-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
    .dial-showcase-{{ section.id }} .ds-header-sub {
      text-align: left;
    }
  }

  .dial-showcase-{{ section.id }} .ds-nav {
    display: flex;
    justify-content: flex-start;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }

  .dial-showcase-{{ section.id }} .ds-filter-pill {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: rgba(255, 255, 255, 0.85);
    border-radius: 50px;
    padding: 8px 22px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .dial-showcase-{{ section.id }} .ds-filter-pill:hover {
    border-color: #ffffff;
    color: #ffffff;
  }

  .dial-showcase-{{ section.id }} .ds-filter-pill.active {
    background: #DA6634;
    border-color: #DA6634;
    color: #ffffff;
  }

  .dial-showcase-{{ section.id }} .ds-dial-carousel {
    display: flex;
    gap: 14px;
    overflow-x: auto;
    padding: 8px 0 28px;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .dial-showcase-{{ section.id }} .ds-dial-carousel::-webkit-scrollbar {
    display: none;
  }

  .dial-showcase-{{ section.id }} .ds-swatch-node {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 6px 10px;
    opacity: 0.5;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .dial-showcase-{{ section.id }} .ds-swatch-node:hover,
  .dial-showcase-{{ section.id }} .ds-swatch-node.active {
    opacity: 1;
    transform: translateY(-4px);
  }

  .dial-showcase-{{ section.id }} .ds-node-circle {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 2px solid rgba(255,255,255,0.2);
    position: relative;
  }

  .dial-showcase-{{ section.id }} .ds-swatch-node.active .ds-node-circle {
    border-color: #ffffff;
    box-shadow: 0 0 0 2px #DA6634;
  }

  .dial-showcase-{{ section.id }} .ds-node-label {
    font-size: 11px;
    font-weight: 600;
    max-width: 95px;
    text-align: center;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .dial-showcase-{{ section.id }} .ds-stage-box {
    background: radial-gradient(circle at 15% 50%, #442116 0%, #251a16 55%, #1d1512 100%);
    border: 1px solid rgba(218, 102, 52, 0.35);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
  }

  .dial-showcase-{{ section.id }} .ds-stage {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 40px;
    padding: 48px;
    align-items: center;
  }

  @media (max-width: 960px) {
    .dial-showcase-{{ section.id }} .ds-stage {
      grid-template-columns: 1fr;
      padding: 32px 24px;
    }
  }

  .dial-showcase-{{ section.id }} .ds-dish-frame {
    width: 320px;
    height: 320px;
    max-width: 100%;
    border-radius: 50%;
    border: 3px solid #DA6634;
    overflow: hidden;
    position: relative;
    margin: 0 auto;
    background-color: #141312;
    box-shadow: 0 0 35px rgba(218, 102, 52, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .dial-showcase-{{ section.id }} .ds-dish-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .dial-showcase-{{ section.id }} .ds-dish-placeholder {
    color: rgba(255, 255, 255, 0.3);
    font-size: 13px;
    text-align: center;
    padding: 20px;
  }

  .dial-showcase-{{ section.id }} .ds-badge-range {
    display: inline-block;
    padding: 4px 14px;
    border-radius: 50px;
    border: 1px solid rgba(218, 102, 52, 0.6);
    color: #DA6634;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 12px;
  }

  .dial-showcase-{{ section.id }} .ds-product-title {
    font-size: clamp(32px, 3.8vw, 48px);
    font-weight: 900;
    line-height: 1.1;
    margin: 0 0 12px;
    color: #ffffff;
  }

  .dial-showcase-{{ section.id }} .ds-product-desc {
    font-size: 15px;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.75);
    margin: 0 0 20px;
  }

  .dial-showcase-{{ section.id }} .ds-actions-row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 22px;
  }

  .dial-showcase-{{ section.id }} .ds-action-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    padding: 7px 16px;
    font-size: 13px;
    font-weight: 700;
    color: #ffffff;
  }

  .dial-showcase-{{ section.id }} .ds-flame-icon {
    width: 14px;
    height: 14px;
    display: inline-block;
    background-color: #DA6634;
    border-radius: 50% 50% 50% 0;
    transform: rotate(-45deg);
  }

  .dial-showcase-{{ section.id }} .ds-perfect-section {
    margin-bottom: 22px;
  }

  .dial-showcase-{{ section.id }} .ds-label-micro {
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.45);
    margin-bottom: 8px;
    display: block;
  }

  .dial-showcase-{{ section.id }} .ds-perfect-pills {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .dial-showcase-{{ section.id }} .ds-pair-pill {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    padding: 6px 14px;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.9);
  }

  .dial-showcase-{{ section.id }} .ds-formats-box {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 28px;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.6);
  }

  .dial-showcase-{{ section.id }} .ds-format-item {
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    padding: 4px 10px;
    color: #ffffff;
    font-size: 12px;
    font-weight: 600;
  }

  .dial-showcase-{{ section.id }} .ds-cta-group {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .dial-showcase-{{ section.id }} .ds-btn-talk {
    background-color: #DA6634;
    color: #ffffff !important;
    padding: 13px 28px;
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    border-radius: 4px;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .dial-showcase-{{ section.id }} .ds-btn-talk:hover {
    background-color: #c75626;
    transform: translateY(-2px);
  }

  .dial-showcase-{{ section.id }} .ds-btn-recipe {
    background-color: transparent;
    color: #ffffff !important;
    border: 1.5px solid rgba(255, 255, 255, 0.4);
    padding: 13px 28px;
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    border-radius: 4px;
    transition: all 0.2s ease;
  }

  .dial-showcase-{{ section.id }} .ds-btn-recipe:hover,
  .dial-showcase-{{ section.id }} .ds-btn-recipe.active {
    border-color: #DA6634;
    background: rgba(218, 102, 52, 0.15);
    color: #DA6634 !important;
  }

  /* Recipe Drawer Styling */
  .dial-showcase-{{ section.id }} .ds-recipe-drawer {
    display: none;
    border-top: 1px solid rgba(218, 102, 52, 0.3);
    background: #1A1715;
    padding: 44px 48px 52px;
  }

  .dial-showcase-{{ section.id }} .ds-recipe-drawer.is-open {
    display: block;
    animation: dsFadeDown 0.3s ease-out;
  }

  @keyframes dsFadeDown {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .dial-showcase-{{ section.id }} .ds-recipe-header-wrap {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 28px;
    gap: 20px;
    flex-wrap: wrap;
  }

  .dial-showcase-{{ section.id }} .ds-recipe-title {
    font-size: clamp(26px, 2.5vw, 34px);
    font-weight: 900;
    color: #ffffff;
    margin: 4px 0 6px;
  }

  .dial-showcase-{{ section.id }} .ds-recipe-subhead {
    font-size: 15px;
    color: rgba(255, 255, 255, 0.65);
    margin: 0;
  }

  .dial-showcase-{{ section.id }} .ds-recipe-meta-pills {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .dial-showcase-{{ section.id }} .ds-meta-pill {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 50px;
    padding: 6px 14px;
    font-size: 13px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.85);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .dial-showcase-{{ section.id }} .ds-recipe-grid {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 48px;
  }

  @media (max-width: 860px) {
    .dial-showcase-{{ section.id }} .ds-recipe-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  .dial-showcase-{{ section.id }} .ds-col-heading {
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #DA6634;
    margin: 0 0 16px;
    border-bottom: 1px solid rgba(218, 102, 52, 0.3);
    padding-bottom: 8px;
  }

  .dial-showcase-{{ section.id }} .ds-ing-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: rgba(255, 255, 255, 0.85);
    font-size: 14.5px;
    line-height: 1.6;
  }

  .dial-showcase-{{ section.id }} .ds-ing-item {
    position: relative;
    padding-left: 14px;
  }

  .dial-showcase-{{ section.id }} .ds-ing-item::before {
    content: "•";
    position: absolute;
    left: 0;
    color: #DA6634;
  }

  .dial-showcase-{{ section.id }} .ds-method-content {
    white-space: pre-line;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.85);
    font-size: 14.5px;
  }
{% endstyle %}

<div class="dial-showcase-{{ section.id }}" id="our-sauces">
  <div class="ds-inner">
    <div class="ds-header-row">
      <h2 class="ds-header-title">Our sauces</h2>
      <p class="ds-header-sub">A complete range of table and cooking sauces. One standard.</p>
    </div>

    <!-- Category Tabs -->
    <div class="ds-nav" role="tablist">
      {% if collection_table != blank and collection_table.products_count > 0 %}
        <button type="button" class="ds-filter-pill active" data-filter="table">{{ collection_table.title }} ({{ collection_table.products_count }})</button>
      {% else %}
        <button type="button" class="ds-filter-pill active" data-filter="table">Table Sauces (7)</button>
      {% endif %}
      
      {% if collection_cooking != blank and collection_cooking.products_count > 0 %}
        <button type="button" class="ds-filter-pill" data-filter="cooking">{{ collection_cooking.title }} ({{ collection_cooking.products_count }})</button>
      {% else %}
        <button type="button" class="ds-filter-pill" data-filter="cooking">Cooking Sauces (6)</button>
      {% endif %}
    </div>

    <!-- Product Swatches -->
    <div class="ds-dial-carousel" id="dsCarousel">
      {% assign global_idx = 0 %}
      {% if collection_table != blank %}
        {% for product in collection_table.products %}
          <button type="button" class="ds-swatch-node{% if global_idx == 0 %} active{% endif %}" data-i="{{ global_idx }}" data-range="table">
            <div class="ds-node-circle" style="background-color: #DA6634;"></div>
            <span class="ds-node-label">{{ product.title }}</span>
          </button>
          {% assign global_idx = global_idx | plus: 1 %}
        {% endfor %}
      {% endif %}

      {% if collection_cooking != blank %}
        {% for product in collection_cooking.products %}
          <button type="button" class="ds-swatch-node{% if global_idx == 0 %} active{% endif %}" data-i="{{ global_idx }}" data-range="cooking">
            <div class="ds-node-circle" style="background-color: #9C331D;"></div>
            <span class="ds-node-label">{{ product.title }}</span>
          </button>
          {% assign global_idx = global_idx | plus: 1 %}
        {% endfor %}
      {% endif %}
    </div>

    <!-- Showcase Stage -->
    <div class="ds-stage-box">
      <div class="ds-stage">
        <!-- Dish Frame -->
        <div class="ds-dish-frame">
          <img id="dsDishImg" class="ds-dish-img" src="" alt="Sauce dish preview" style="display: none;">
          <div id="dsDishPlaceholder" class="ds-dish-placeholder">Dish photo coming soon</div>
        </div>

        <!-- Details -->
        <div class="ds-stage-info">
          <span class="ds-badge-range" id="dsBadgeRange">Table Sauces</span>
          <h3 class="ds-product-title" id="dsProductTitle"></h3>
          <p class="ds-product-desc" id="dsProductDesc"></p>

          <div class="ds-actions-row" id="dsActionsWrap"></div>

          <div class="ds-perfect-section" id="dsPerfectWrap">
            <span class="ds-label-micro">PERFECT WITH</span>
            <div class="ds-perfect-pills" id="dsPerfectPills"></div>
          </div>

          <div class="ds-formats-box">
            <span>Available in:</span>
            <span class="ds-format-item">Sachets</span>
            <span class="ds-format-item">Table bottles</span>
            <span class="ds-format-item">Tubs</span>
          </div>

          <div class="ds-cta-group">
            <a href="/pages/contact" class="ds-btn-talk">Talk to the team</a>
            <button type="button" class="ds-btn-recipe" id="dsRecipeToggle" style="display: none;">Get the recipe</button>
          </div>
        </div>
      </div>

      <!-- Slide-down Recipe Drawer -->
      <div class="ds-recipe-drawer" id="dsRecipeDrawer">
        <div class="ds-recipe-header-wrap">
          <div>
            <span class="ds-badge-range" style="margin-bottom: 6px;">SERVING SUGGESTION</span>
            <h4 class="ds-recipe-title" id="dsDrawerTitle"></h4>
            <p class="ds-recipe-subhead" id="dsDrawerSubhead"></p>
          </div>
          <div class="ds-recipe-meta-pills">
            <span class="ds-meta-pill" id="dsDrawerServes" style="display: none;">
              👤 <span class="ds-serves-text"></span>
            </span>
            <span class="ds-meta-pill" id="dsDrawerTime" style="display: none;">
              ⏱️ <span class="ds-time-text"></span>
            </span>
          </div>
        </div>

        <div class="ds-recipe-grid">
          <div>
            <h5 class="ds-col-heading">You'll need</h5>
            <div class="ds-ing-list" id="dsDrawerIngredients"></div>
          </div>
          <div>
            <h5 class="ds-col-heading">Method</h5>
            <div class="ds-method-content" id="dsDrawerMethod"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    function initDynamicSauces() {
      var root = document.querySelector('#our-sauces');
      if (!root) return;

      var sauceData = [
        {% assign is_first = true %}
        {% if collection_table != blank %}
          {% for product in collection_table.products %}
            {% unless is_first %},{% endunless %}
            {
              name: {{ product.title | json }},
              desc: {{ product.description | strip_html | truncatewords: 24 | json }},
              range_slug: "table",
              range_label: "Table Sauces",
              dish_image: {% if product.metafields.custom.recipe_dish_image.value != blank %}{{ product.metafields.custom.recipe_dish_image.value | image_url: width: 800 | json }}{% elsif product.featured_image != blank %}{{ product.featured_image | image_url: width: 800 | json }}{% else %}""{% endif %},
              actions: {{ product.metafields.custom.cooking_actions.value | json }},
              perfect_with: {{ product.metafields.custom.perfect_with.value | json }},
              recipe_title: {{ product.metafields.custom.recipe_title.value | json }},
              recipe_subhead: {{ product.metafields.custom.recipe_summary.value | json }},
              recipe_serves: {{ product.metafields.custom.recipe_serves.value | default: 'Serves 4' | json }},
              recipe_time: {{ product.metafields.custom.recipe_prep_time.value | default: '25 mins' | json }},
              recipe_ingredients: {{ product.metafields.custom.recipe_ingredients.value | json }},
              recipe_method: {{ product.metafields.custom.recipe_method.value | json }}
            }
            {% assign is_first = false %}
          {% endfor %}
        {% endif %}
        {% if collection_cooking != blank %}
          {% for product in collection_cooking.products %}
            {% unless is_first %},{% endunless %}
            {
              name: {{ product.title | json }},
              desc: {{ product.description | strip_html | truncatewords: 24 | default: '[Product description to be added from the live site]' | json }},
              range_slug: "cooking",
              range_label: "Cooking Sauces",
              dish_image: {% if product.metafields.custom.recipe_dish_image.value != blank %}{{ product.metafields.custom.recipe_dish_image.value | image_url: width: 800 | json }}{% elsif product.featured_image != blank %}{{ product.featured_image | image_url: width: 800 | json }}{% else %}""{% endif %},
              actions: {{ product.metafields.custom.cooking_actions.value | json }},
              perfect_with: {{ product.metafields.custom.perfect_with.value | json }},
              recipe_title: {{ product.metafields.custom.recipe_title.value | json }},
              recipe_subhead: {{ product.metafields.custom.recipe_summary.value | json }},
              recipe_serves: {{ product.metafields.custom.recipe_serves.value | default: 'Serves 4' | json }},
              recipe_time: {{ product.metafields.custom.recipe_prep_time.value | default: '25 mins' | json }},
              recipe_ingredients: {{ product.metafields.custom.recipe_ingredients.value | json }},
              recipe_method: {{ product.metafields.custom.recipe_method.value | json }}
            }
            {% assign is_first = false %}
          {% endfor %}
        {% endif %}
      ];

      var nodes = root.querySelectorAll('.ds-swatch-node');
      var filterBtns = root.querySelectorAll('.ds-filter-pill');
      var dishImg = root.querySelector('#dsDishImg');
      var dishPlaceholder = root.querySelector('#dsDishPlaceholder');
      var titleEl = root.querySelector('#dsProductTitle');
      var descEl = root.querySelector('#dsProductDesc');
      var badgeRange = root.querySelector('#dsBadgeRange');
      var actionsWrap = root.querySelector('#dsActionsWrap');
      var perfectWrap = root.querySelector('#dsPerfectWrap');
      var perfectPills = root.querySelector('#dsPerfectPills');
      var recipeBtn = root.querySelector('#dsRecipeToggle');
      var recipeDrawer = root.querySelector('#dsRecipeDrawer');
      var drawerTitle = root.querySelector('#dsDrawerTitle');
      var drawerSubhead = root.querySelector('#dsDrawerSubhead');
      var drawerServes = root.querySelector('#dsDrawerServes');
      var drawerTime = root.querySelector('#dsDrawerTime');
      var drawerIng = root.querySelector('#dsDrawerIngredients');
      var drawerMethod = root.querySelector('#dsDrawerMethod');

      function setActiveSauce(i) {
        var item = sauceData[i];
        if (!item) return;

        if (titleEl) titleEl.textContent = item.name;
        if (descEl) descEl.textContent = item.desc;
        if (badgeRange) badgeRange.textContent = item.range_label;

        // Image Handling with Placeholder fallback
        if (dishImg && dishPlaceholder) {
          if (item.dish_image && item.dish_image !== '') {
            dishImg.src = item.dish_image;
            dishImg.style.display = 'block';
            dishPlaceholder.style.display = 'none';
          } else {
            dishImg.style.display = 'none';
            dishPlaceholder.style.display = 'block';
          }
        }

        // Cooking Actions
        if (actionsWrap) {
          actionsWrap.innerHTML = '';
          var acts = item.actions;
          if (acts && acts.length > 0) {
            acts.forEach(function (act) {
              var span = document.createElement('span');
              span.className = 'ds-action-tag';
              span.innerHTML = '<span class="ds-flame-icon"></span> ' + act;
              actionsWrap.appendChild(span);
            });
            actionsWrap.style.display = 'flex';
          } else {
            actionsWrap.style.display = 'none';
          }
        }

        // Perfect With
        if (perfectWrap && perfectPills) {
          perfectPills.innerHTML = '';
          if (item.perfect_with && item.perfect_with.length > 0) {
            item.perfect_with.forEach(function (p) {
              var pill = document.createElement('span');
              pill.className = 'ds-pair-pill';
              pill.textContent = p;
              perfectPills.appendChild(pill);
            });
            perfectWrap.style.display = 'block';
          } else {
            perfectWrap.style.display = 'none';
          }
        }

        // Recipe Drawer Info
        var hasRecipe = item.recipe_title || item.recipe_ingredients || item.recipe_method;
        if (recipeBtn) {
          if (hasRecipe) {
            recipeBtn.style.display = 'inline-block';
            recipeBtn.classList.remove('active');
            recipeBtn.textContent = 'Get the recipe';
          } else {
            recipeBtn.style.display = 'none';
          }
        }

        if (recipeDrawer) {
          recipeDrawer.classList.remove('is-open');
          if (drawerTitle) drawerTitle.textContent = item.recipe_title || item.name;
          
          if (drawerSubhead) {
            if (item.recipe_subhead) {
              drawerSubhead.textContent = item.recipe_subhead;
              drawerSubhead.style.display = 'block';
            } else {
              drawerSubhead.style.display = 'none';
            }
          }

          if (drawerServes) {
            if (item.recipe_serves) {
              drawerServes.querySelector('.ds-serves-text').textContent = item.recipe_serves;
              drawerServes.style.display = 'inline-flex';
            } else {
              drawerServes.style.display = 'none';
            }
          }

          if (drawerTime) {
            if (item.recipe_time) {
              drawerTime.querySelector('.ds-time-text').textContent = item.recipe_time;
              drawerTime.style.display = 'inline-flex';
            } else {
              drawerTime.style.display = 'none';
            }
          }

          // Split ingredients cleanly by newline or commas
          if (drawerIng) {
            drawerIng.innerHTML = '';
            if (item.recipe_ingredients) {
              var rawIng = item.recipe_ingredients;
              var items = rawIng.includes('\n') ? rawIng.split('\n') : rawIng.split(',');
              items.forEach(function (ing) {
                var clean = ing.trim();
                if (clean) {
                  var div = document.createElement('div');
                  div.className = 'ds-ing-item';
                  div.textContent = clean;
                  drawerIng.appendChild(div);
                }
              });
            }
          }

          if (drawerMethod) drawerMethod.textContent = item.recipe_method || '';
        }

        // Highlight Active Swatch
        nodes.forEach(function (n) { n.classList.remove('active'); });
        var activeNode = root.querySelector('.ds-swatch-node[data-i="' + i + '"]');
        if (activeNode) activeNode.classList.add('active');
      }

      // Toggle drawer
      if (recipeBtn && recipeDrawer) {
        recipeBtn.onclick = function () {
          var isOpen = recipeDrawer.classList.toggle('is-open');
          recipeBtn.classList.toggle('active', isOpen);
          recipeBtn.textContent = isOpen ? 'Hide recipe' : 'Get the recipe';
          if (isOpen) {
            recipeDrawer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
        };
      }

      // Swatch Click
      nodes.forEach(function (node) {
        node.onclick = function () {
          setActiveSauce(parseInt(node.dataset.i, 10));
        };
      });

      // Filter Tab Click
      filterBtns.forEach(function (btn) {
        btn.onclick = function () {
          filterBtns.forEach(function (b) { b.classList.remove('active'); });
          btn.classList.add('active');
          var filter = btn.dataset.filter;
          var firstMatch = null;

          nodes.forEach(function (node) {
            if (node.dataset.range === filter) {
              node.style.display = 'flex';
              if (firstMatch === null) firstMatch = parseInt(node.dataset.i, 10);
            } else {
              node.style.display = 'none';
            }
          });

          if (firstMatch !== null) setActiveSauce(firstMatch);
        };
      });

      // Init first view
      var initialBtn = root.querySelector('.ds-filter-pill.active');
      if (initialBtn) initialBtn.click();
      else if (sauceData.length) setActiveSauce(0);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initDynamicSauces);
    } else {
      initDynamicSauces();
    }
  })();
</script>

{% schema %}
{
  "name": "Flavour Dial Showcase",
  "tag": "section",
  "settings": [
    { "type": "collection", "id": "collection_table", "label": "Table Sauces Collection" },
    { "type": "collection", "id": "collection_cooking", "label": "Cooking Sauces Collection" }
  ],
  "presets": [
    { "name": "Flavour Dial Showcase" }
  ]
}
{% endschema %}
