{% style %}
  .flavour-switcher-{{ section.id }} {
    --fs-accent: {{ section.settings.accent_color | default: '#DA6634' }};
    --fs-text-main: {{ section.settings.text_color | default: '#FBF3E4' }};
    --fs-text-muted: {{ section.settings.muted_text_color | default: '#D6CDBF' }};
    --fs-panel-bg: {{ section.settings.panel_bg | default: '#2A2620' }};
  }

  .flavour-switcher-{{ section.id }} .cs-section-header * {
    color: var(--fs-text-main) !important;
  }

  /* Range Filter Bar */
  .flavour-switcher-{{ section.id }} .fs-range-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }

  .flavour-switcher-{{ section.id }} .fs-range-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--fs-text-muted);
    border-radius: 50px;
    padding: 7px 16px;
    font-size: 12.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .flavour-switcher-{{ section.id }} .fs-range-btn:hover {
    color: var(--fs-text-main);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .flavour-switcher-{{ section.id }} .fs-range-btn.active {
    background: var(--fs-accent);
    color: #ffffff;
    border-color: var(--fs-accent);
    box-shadow: 0 4px 12px rgba(218, 102, 52, 0.3);
  }

  /* Main Shell */
  .flavour-switcher-{{ section.id }} .fs-shell {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 32px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    padding: 32px;
    background: var(--fs-panel-bg);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
    align-items: center;
  }

  @media (max-width: 991px) {
    .flavour-switcher-{{ section.id }} .fs-shell {
      grid-template-columns: 1fr;
      padding: 24px;
      gap: 28px;
    }
  }

  /* Tag/Chip Cloud (No scrollbar, wrapping chips) */
  .flavour-switcher-{{ section.id }} .fs-chip-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-content: flex-start;
  }

  .flavour-switcher-{{ section.id }} .fs-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--fs-text-muted);
    border-radius: 50px;
    padding: 8px 14px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    user-select: none;
  }

  .flavour-switcher-{{ section.id }} .fs-chip:hover {
    background: rgba(255, 255, 255, 0.09);
    color: var(--fs-text-main);
    border-color: rgba(255, 255, 255, 0.22);
    transform: translateY(-1px);
  }

  .flavour-switcher-{{ section.id }} .fs-chip.active {
    background: rgba(255, 255, 255, 0.14);
    color: #ffffff;
    font-weight: 700;
    border-color: var(--fs-accent);
    box-shadow: 0 0 0 1px var(--fs-accent);
  }

  .flavour-switcher-{{ section.id }} .fs-chip-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    flex-shrink: 0;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.2);
  }

  /* Featured Showcase Card (Right) */
  .flavour-switcher-{{ section.id }} .fs-card {
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 36px 30px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    min-height: 300px;
  }

  .flavour-switcher-{{ section.id }} .fs-card-range-tag {
    display: inline-block;
    align-self: flex-start;
    padding: 4px 12px;
    border-radius: 50px;
    background: rgba(218, 102, 52, 0.15);
    border: 1px solid rgba(218, 102, 52, 0.35);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fs-accent);
    margin-bottom: 16px;
  }

  .flavour-switcher-{{ section.id }} .fs-card-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
  }

  .flavour-switcher-{{ section.id }} .fs-swatch-big {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    flex-shrink: 0;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.4), inset 0 0 0 2px rgba(255, 255, 255, 0.25);
    transition: background 0.25s ease;
  }

  .flavour-switcher-{{ section.id }} .fs-name {
    font-size: clamp(22px, 2.6vw, 30px);
    font-weight: 800;
    line-height: 1.15;
    margin: 0;
    color: var(--fs-text-main) !important;
  }

  .flavour-switcher-{{ section.id }} .fs-desc {
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--fs-text-muted) !important;
    margin: 0 0 24px;
  }

  .flavour-switcher-{{ section.id }} .fs-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .flavour-switcher-{{ section.id }} .fs-cta-btn {
    display: inline-flex;
    align-items: center;
    background: var(--fs-accent);
    color: #ffffff;
    text-decoration: none;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 10px 22px;
    border-radius: 50px;
    transition: opacity 0.2s ease, transform 0.15s ease;
  }

  .flavour-switcher-{{ section.id }} .fs-cta-btn:hover {
    opacity: 0.9;
    transform: scale(0.98);
  }

  .flavour-switcher-{{ section.id }} .fs-card-badges {
    font-size: 11.5px;
    color: var(--fs-text-muted);
    opacity: 0.75;
  }
{% endstyle %}

<div class="flavour-switcher-{{ section.id }} section-{{ section.id }}-padding container page-width" style="background:{{ section.settings.bg_color | default: 'transparent' }};">
  <div class="cs-section-header text-start" style="margin-bottom: 24px;">
    {% render 'heading',
      heading: section.settings.heading,
      heading_tag: section.settings.heading_tag,
      heading_size: section.settings.heading_size,
      preheading: section.settings.preheading,
      subheading: section.settings.subheading
    %}
  </div>

  <!-- Category Nav -->
  <div class="fs-range-nav" role="tablist">
    <button type="button" class="fs-range-btn active" data-filter="all">All 15 Sauces</button>
    <button type="button" class="fs-range-btn" data-filter="Table Sauces">Table Sauces (6)</button>
    <button type="button" class="fs-range-btn" data-filter="Cooking Sauces">Cooking Sauces (6)</button>
    <button type="button" class="fs-range-btn" data-filter="Base Sauces">Kitchen Bases (3)</button>
  </div>

  <div class="fs-shell">
    <!-- Left: Compact Chip/Pill Cloud -->
    <div class="fs-chip-grid" role="tablist">
      {% for block in section.blocks %}
        <button
          type="button"
          class="fs-chip{% if forloop.first %} active{% endif %}"
          data-i="{{ forloop.index0 }}"
          data-range="{{ block.settings.range_category | default: 'Table Sauces' }}"
          {{ block.shopify_attributes }}
        >
          <span class="fs-chip-dot" style="background-color: {{ block.settings.color }};"></span>
          <span>{{ block.settings.name }}</span>
        </button>
      {% endfor %}
    </div>

    <!-- Right: High-Impact Showcase Card -->
    <div class="fs-card">
      <span class="fs-card-range-tag">Table Sauces</span>
      <div class="fs-card-header">
        <div class="fs-swatch-big"></div>
        <h3 class="fs-name"></h3>
      </div>
      <p class="fs-desc"></p>

      <div class="fs-actions">
        <a href="/pages/contact?subject=Trade%20Enquiry%20-%20The%20Range" class="fs-cta-btn">
          Request Specs / Quote
        </a>
        <span class="fs-card-badges">14 Allergens Free • 100% UPF-Free</span>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.currentScript.previousElementSibling;
    var data = [
      {% for block in section.blocks %}
        {
          name: {{ block.settings.name | json }},
          desc: {{ block.settings.description | json }},
          color: {{ block.settings.color | json }},
          range: {{ block.settings.range_category | default: 'Table Sauces' | json }}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ];

    var chips = root.querySelectorAll('.fs-chip');
    var filterBtns = root.querySelectorAll('.fs-range-btn');
    var swatch = root.querySelector('.fs-swatch-big');
    var nameEl = root.querySelector('.fs-name');
    var descEl = root.querySelector('.fs-desc');
    var tagEl = root.querySelector('.fs-card-range-tag');

    function selectSauce(i) {
      var item = data[i];
      if (!item) return;

      nameEl.style.opacity = '0';
      descEl.style.opacity = '0';

      setTimeout(function () {
        nameEl.textContent = item.name;
        descEl.textContent = item.desc;
        tagEl.textContent = item.range;
        swatch.style.background = item.color;
        nameEl.style.opacity = '1';
        descEl.style.opacity = '1';
      }, 90);
    }

    chips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        chips.forEach(function (c) { c.classList.remove('active'); });
        chip.classList.add('active');
        selectSauce(parseInt(chip.dataset.i, 10));
      });
    });

    filterBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        filterBtns.forEach(function (b) { b.classList.remove('active'); });
        btn.classList.add('active');

        var filter = btn.dataset.filter;
        var firstVisibleIndex = null;

        chips.forEach(function (chip) {
          var itemRange = chip.dataset.range;
          if (filter === 'all' || itemRange === filter) {
            chip.style.display = 'inline-flex';
            if (firstVisibleIndex === null) {
              firstVisibleIndex = parseInt(chip.dataset.i, 10);
            }
          } else {
            chip.style.display = 'none';
          }
        });

        if (firstVisibleIndex !== null) {
          chips.forEach(function (c) { c.classList.remove('active'); });
          var activeChip = root.querySelector('.fs-chip[data-i="' + firstVisibleIndex + '"]');
          if (activeChip) activeChip.classList.add('active');
          selectSauce(firstVisibleIndex);
        }
      });
    });

    if (data.length) selectSauce(0);
  })();
</script>

{% schema %}
{
  "name": "Flavour switcher",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "preheading", "label": "Preheading", "default": "The Range" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "15 sauces. Three ranges. One standard." },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>Naturally allergen-free. Formulated without ultra-processed ingredients.</p>" },
    { "type": "select", "id": "heading_tag", "options": [
        { "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" }
      ], "default": "h2", "label": "Heading tag" },
    { "type": "select", "id": "heading_size", "options": [
        { "value": "h1", "label": "H1" }, { "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" }
      ], "default": "h2", "label": "Heading size" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#DA6634" },
    { "type": "color", "id": "panel_bg", "label": "Panel background", "default": "#2A2620" },
    { "type": "color", "id": "bg_color", "label": "Section background", "default": "#231F1A" },
    { "type": "color", "id": "text_color", "label": "Heading & active text color", "default": "#FBF3E4" },
    { "type": "color", "id": "muted_text_color", "label": "Description & tag text color", "default": "#D6CDBF" }
  ],
  "blocks": [
    {
      "type": "flavour",
      "name": "Flavour SKU",
      "settings": [
        { "type": "text", "id": "name", "label": "Sauce name", "default": "Sauce Name" },
        {
          "type": "select",
          "id": "range_category",
          "label": "Range Category",
          "options": [
            { "value": "Table Sauces", "label": "Table Sauces" },
            { "value": "Cooking Sauces", "label": "Cooking Sauces" },
            { "value": "Base Sauces", "label": "Kitchen Base Sauces" }
          ],
          "default": "Table Sauces"
        },
        { "type": "textarea", "id": "description", "label": "Serving suggestion & Menu use", "default": "Serving suggestion goes here." },
        { "type": "color", "id": "color", "label": "Swatch accent color", "default": "#C13B2A" }
      ]
    }
  ]
}
{% endschema %}
