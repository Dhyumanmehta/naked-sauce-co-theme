{% style %}
  .nsc-contact-section {
    --nsc-charcoal: #231F1A;
    --nsc-panel: #2A2620;
    --nsc-cream: #FBF3E4;
    --nsc-terracotta: #DA6634;
    --nsc-olive: #5F6B3E;
    --nsc-muted: #D6CDBF;
    --nsc-border: rgba(251, 243, 228, 0.12);

    background-color: var(--nsc-charcoal);
    color: var(--nsc-cream);
    padding: 70px 20px 80px;
  }

  .nsc-contact-container {
    max-width: 1040px;
    margin: 0 auto;
  }

  /* Header */
  .nsc-contact-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 40px;
  }

  .nsc-contact-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(218, 102, 52, 0.15);
    border: 1px solid rgba(218, 102, 52, 0.35);
    color: var(--nsc-terracotta);
    padding: 6px 16px;
    border-radius: 50px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 16px;
  }

  .nsc-contact-title {
    font-size: clamp(32px, 4.5vw, 48px);
    font-weight: 900;
    line-height: 1.1;
    margin: 0 0 14px;
    color: #ffffff;
    text-transform: uppercase;
  }

  .nsc-contact-subtitle {
    font-size: 16px;
    line-height: 1.6;
    color: var(--nsc-muted);
    margin: 0;
  }

  /* Form Container */
  .nsc-form-card {
    background: var(--nsc-panel);
    border: 1px solid var(--nsc-border);
    border-radius: 18px;
    padding: 40px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
    margin-bottom: 60px;
  }

  @media (max-width: 768px) {
    .nsc-form-card {
      padding: 24px;
    }
  }

  /* SLA Guarantee Banner */
  .nsc-sla-banner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: rgba(95, 107, 62, 0.15);
    border: 1px solid rgba(95, 107, 62, 0.35);
    color: #A4B27C;
    border-radius: 10px;
    padding: 12px 20px;
    margin-bottom: 28px;
    font-size: 13.5px;
    font-weight: 600;
    text-align: center;
  }

  /* Tab Navigation */
  .nsc-form-tabs {
    display: flex;
    gap: 10px;
    margin-bottom: 28px;
    border-bottom: 1px solid var(--nsc-border);
    padding-bottom: 16px;
  }

  .nsc-tab-btn {
    flex: 1;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--nsc-border);
    color: var(--nsc-muted);
    padding: 12px 18px;
    border-radius: 8px;
    font-size: 13.5px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
    text-align: center;
  }

  .nsc-tab-btn.active {
    background: var(--nsc-terracotta);
    border-color: var(--nsc-terracotta);
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(218, 102, 52, 0.3);
  }

  /* Form Fields */
  .nsc-field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
  }

  @media (max-width: 768px) {
    .nsc-field-row {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }

  .nsc-field-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 20px;
  }

  .nsc-label {
    font-size: 12.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--nsc-cream);
  }

  .nsc-input, 
  .nsc-select, 
  .nsc-textarea {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--nsc-border);
    border-radius: 8px;
    padding: 12px 16px;
    color: var(--nsc-cream);
    font-size: 14px;
    outline: none;
    transition: border-color 0.2s ease;
    width: 100%;
    box-sizing: border-box;
  }

  .nsc-input:focus, 
  .nsc-select:focus, 
  .nsc-textarea:focus {
    border-color: var(--nsc-terracotta);
    background: rgba(255, 255, 255, 0.08);
  }

  .nsc-select option {
    background: var(--nsc-panel);
    color: var(--nsc-cream);
  }

  .nsc-textarea {
    resize: vertical;
    min-height: 120px;
  }

  .nsc-submit {
    background: var(--nsc-terracotta);
    color: #ffffff;
    border: none;
    border-radius: 50px;
    padding: 14px 34px;
    font-size: 13.5px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 6px 18px rgba(218, 102, 52, 0.35);
  }

  .nsc-submit:hover {
    background: #E87442;
    transform: translateY(-2px);
  }

  /* Process Timeline */
  .nsc-process-wrapper {
    padding-top: 20px;
  }

  .nsc-process-header {
    text-align: center;
    margin-bottom: 36px;
  }

  .nsc-process-title {
    font-size: 26px;
    font-weight: 900;
    text-transform: uppercase;
    margin: 0 0 10px;
    color: #ffffff;
  }

  .nsc-process-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  @media (max-width: 900px) {
    .nsc-process-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }

  @media (max-width: 550px) {
    .nsc-process-grid {
      grid-template-columns: 1fr;
    }
  }

  .nsc-step-card {
    background: var(--nsc-panel);
    border: 1px solid var(--nsc-border);
    border-radius: 14px;
    padding: 24px 20px;
    position: relative;
  }

  .nsc-step-num {
    font-size: 12px;
    font-weight: 900;
    color: var(--nsc-terracotta);
    letter-spacing: 0.1em;
    margin-bottom: 10px;
    display: block;
  }

  .nsc-step-heading {
    font-size: 16px;
    font-weight: 800;
    margin: 0 0 8px;
    color: var(--nsc-cream);
  }

  .nsc-step-desc {
    font-size: 13px;
    line-height: 1.55;
    color: var(--nsc-muted);
    margin: 0;
  }
{% endstyle %}

<section class="nsc-contact-section">
  <div class="nsc-contact-container">

    <!-- Header -->
    <div class="nsc-contact-header">
      <span class="nsc-contact-badge">Direct From The Kitchen</span>
      <h1 class="nsc-contact-title">Get In Touch</h1>
      <p class="nsc-contact-subtitle">
        Whether you are inquiring about a home pantry order or requesting commercial wholesale pricing and samples for your hospitality venue, we are here to help.
      </p>
    </div>

    <!-- Contact Form Box -->
    <div class="nsc-form-card">
      <!-- 24-48 SLA Guarantee -->
      <div class="nsc-sla-banner">
        <span>⏱ <strong>Response Guarantee:</strong> Our culinary team replies to all trade, wholesale, and consumer inquiries within <strong>24–48 business hours</strong>.</span>
      </div>

      <!-- General vs Trade Tabs -->
      <div class="nsc-form-tabs" role="tablist">
        <button type="button" class="nsc-tab-btn active" id="tabGeneral" onclick="switchForm('general')">
          General & Consumer Inquiry
        </button>
        <button type="button" class="nsc-tab-btn" id="tabTrade" onclick="switchForm('trade')">
          Trade, Catering & Wholesale
        </button>
      </div>

      {% form 'contact', id: 'nscContactForm' %}
        {% if form.posted_successfully? %}
          <div style="background: rgba(95, 107, 62, 0.25); border: 1px solid var(--nsc-olive); padding: 16px; border-radius: 8px; margin-bottom: 24px; text-align: center; color: #ffffff;">
            ✓ <strong>Thank you!</strong> Your message has been received. Our team will get back to you within 24–48 hours.
          </div>
        {% endif %}

        {% if form.errors %}
          <div style="color: #DA6634; margin-bottom: 20px; font-weight: 600;">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <!-- Hidden input tracking inquiry type -->
        <input type="hidden" name="contact[Inquiry Type]" id="inquiryTypeField" value="General Inquiry">

        <!-- Name & Email (Universal) -->
        <div class="nsc-field-row">
          <div class="nsc-field-group">
            <label class="nsc-label" for="ContactFormName">Your Name *</label>
            <input type="text" id="ContactFormName" name="contact[name]" class="nsc-input" placeholder="e.g. Alex Morgan" required>
          </div>
          <div class="nsc-field-group">
            <label class="nsc-label" for="ContactFormEmail">Email Address *</label>
            <input type="email" id="ContactFormEmail" name="contact[email]" class="nsc-input" placeholder="alex@company.com" required autocorrect="off" autocapitalize="off">
          </div>
        </div>

        <!-- Phone & Subject -->
        <div class="nsc-field-row">
          <div class="nsc-field-group">
            <label class="nsc-label" for="ContactFormPhone">Phone Number (Optional)</label>
            <input type="tel" id="ContactFormPhone" name="contact[phone]" class="nsc-input" placeholder="+44 7123 456789">
          </div>
          <div class="nsc-field-group">
            <label class="nsc-label" for="ContactFormSubject">Subject</label>
            <input type="text" id="ContactFormSubject" name="contact[subject]" class="nsc-input" placeholder="How can we help?">
          </div>
        </div>

        <!-- TRADE ONLY DYNAMIC FIELDS -->
        <div id="tradeFields" style="display: none;">
          <div class="nsc-field-row">
            <div class="nsc-field-group">
              <label class="nsc-label" for="TradeCompany">Company / Venue Name *</label>
              <input type="text" id="TradeCompany" name="contact[Company Name]" class="nsc-input" placeholder="e.g. The Garden Bistro Group">
            </div>
            <div class="nsc-field-group">
              <label class="nsc-label" for="TradeType">Business Type</label>
              <select id="TradeType" name="contact[Business Type]" class="nsc-select">
                <option value="Restaurant / Pub Group">Restaurant / Pub Group</option>
                <option value="Contract Caterer / Hospitality">Contract Caterer / Hospitality</option>
                <option value="Retailer / Farm Shop / Deli">Retailer / Farm Shop / Deli</option>
                <option value="Foodservice Wholesaler">Foodservice Wholesaler</option>
                <option value="Other">Other</option>
              </select>
            </div>
          </div>

          <div class="nsc-field-row">
            <div class="nsc-field-group">
              <label class="nsc-label" for="TradeFormat">Required Packaging Format(s)</label>
              <select id="TradeFormat" name="contact[Packaging Format]" class="nsc-select">
                <option value="Table Squeezy Bottles (250ml)">Table Squeezy Bottles (250ml)</option>
                <option value="Individual Portion Sachets">Individual Portion Sachets</option>
                <option value="Kitchen Tubs & Pails (500ml / 2.5L / 5L)">Kitchen Tubs & Pails (500ml / 2.5L / 5L)</option>
                <option value="Bag-in-Box Dispenser (10L)">Bag-in-Box Dispenser (10L)</option>
                <option value="Mixed / Sample Pack">Mixed / Sample Request</option>
              </select>
            </div>
            <div class="nsc-field-group">
              <label class="nsc-label" for="TradeVolume">Estimated Monthly Volume</label>
              <select id="TradeVolume" name="contact[Estimated Volume]" class="nsc-select">
                <option value="Trial / Sample Only">Trial / Sample Request</option>
                <option value="Under 50 Units / Cases">Under 50 Units / Cases</option>
                <option value="50 - 200 Cases">50 - 200 Cases</option>
                <option value="200+ Cases (Pallet quantities)">200+ Cases (Pallet quantities)</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Message Body -->
        <div class="nsc-field-group">
          <label class="nsc-label" for="ContactFormMessage">Message Details *</label>
          <textarea id="ContactFormMessage" name="contact[body]" class="nsc-textarea" placeholder="Tell us more about your inquiry or which specific sauces you are interested in..." required></textarea>
        </div>

        <div style="text-align: right; margin-top: 10px;">
          <button type="submit" class="nsc-submit" id="submitBtn">
            Send Inquiry
          </button>
        </div>
      {% endform %}
    </div>

    <!-- Delivery & Fulfillment Process Section -->
    <div class="nsc-process-wrapper">
      <div class="nsc-process-header">
        <span class="nsc-contact-badge" style="background: rgba(95, 107, 62, 0.15); border-color: rgba(95, 107, 62, 0.35); color: #A4B27C;">
          Fulfillment & Supply
        </span>
        <h2 class="nsc-process-title">Delivery & Kitchen Process</h2>
        <p class="nsc-contact-subtitle">How we batch-craft, pack, and supply your kitchen or pantry with verified allergen-safe condiments.</p>
      </div>

      <div class="nsc-process-grid">
        <!-- Step 1 -->
        <div class="nsc-step-card">
          <span class="nsc-step-num">STEP 01</span>
          <h3 class="nsc-step-heading">Crafted & Tested</h3>
          <p class="nsc-step-desc">
            Formulated in verified allergen-free kitchens[cite: 1]. Every batch is independently tested to guarantee 0 traces across all 14 major allergens and 0 ultra-processed additives[cite: 1].
          </p>
        </div>

        <!-- Step 2 -->
        <div class="nsc-step-card">
          <span class="nsc-step-num">STEP 02</span>
          <h3 class="nsc-step-heading">Packaged For Purpose</h3>
          <p class="nsc-step-desc">
            Packed into sealed formats: single-serve sachets, front-of-house squeeze bottles, 500ml/bulk prep tubs, or 10L Bag-in-Box.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="nsc-step-card">
          <span class="nsc-step-num">STEP 03</span>
          <h3 class="nsc-step-heading">Dispatched Ambient</h3>
          <p class="nsc-step-desc">
            Shipped across the UK mainland via tracked ambient couriers. Delivered within 2–3 working days for wholesale cases and retail orders.
          </p>
        </div>

        <!-- Step 4 -->
        <div class="nsc-step-card">
          <span class="nsc-step-num">STEP 04</span>
          <h3 class="nsc-step-heading">Ongoing Kitchen Care</h3>
          <p class="nsc-step-desc">
            Direct account management via <em>sales@thenakedsauceco.com</em> with standing orders, spec sheets, and customized venue stock refills.
          </p>
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  function switchForm(type) {
    var tabGeneral = document.getElementById('tabGeneral');
    var tabTrade = document.getElementById('tabTrade');
    var tradeFields = document.getElementById('tradeFields');
    var inquiryType = document.getElementById('inquiryTypeField');
    var submitBtn = document.getElementById('submitBtn');
    var companyInput = document.getElementById('TradeCompany');

    if (type === 'trade') {
      tabGeneral.classList.remove('active');
      tabTrade.classList.add('active');
      tradeFields.style.display = 'block';
      inquiryType.value = 'Trade & Foodservice Wholesale Quote';
      submitBtn.textContent = 'Request Trade Quote & Samples';
      companyInput.setAttribute('required', 'required');
    } else {
      tabTrade.classList.remove('active');
      tabGeneral.classList.add('active');
      tradeFields.style.display = 'none';
      inquiryType.value = 'General Inquiry';
      submitBtn.textContent = 'Send Inquiry';
      companyInput.removeAttribute('required');
    }
  }

  // Auto-switch to trade tab if URL has ?subject=Quote or ?trade=true
  document.addEventListener('DOMContentLoaded', function () {
    var urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('subject') && urlParams.get('subject').toLowerCase().includes('quote')) {
      switchForm('trade');
      var subjectInput = document.getElementById('ContactFormSubject');
      if (subjectInput) {
        subjectInput.value = urlParams.get('subject');
      }
    }
  });
</script>

{% schema %}
{
  "name": "Contact & Trade Form",
  "settings": []
}
{% endschema %}
