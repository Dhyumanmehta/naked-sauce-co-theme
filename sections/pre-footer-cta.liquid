{% style %}
  .closing-cta-{{ section.id }} {
    background-color: #141312;
    color: #ffffff;
    padding-top: 80px;
    padding-bottom: 90px;
    text-align: center;
    position: relative;
    overflow: hidden;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .closing-cta-{{ section.id }} .cta-inner {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .closing-cta-{{ section.id }} .cta-heading {
    font-size: clamp(34px, 4.2vw, 54px);
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin: 0 0 16px;
  }

  .closing-cta-{{ section.id }} .cta-subheading {
    font-size: clamp(15px, 1.25vw, 18px);
    color: rgba(255, 255, 255, 0.72);
    margin: 0 0 32px;
    max-width: 620px;
    line-height: 1.55;
  }

  /* Image between statement and button */
  .closing-cta-{{ section.id }} .cta-media-wrap {
    margin: 8px 0 36px;
    width: 100%;
    max-width: 540px;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
    border: 1px solid rgba(218, 102, 52, 0.25);
  }

  .closing-cta-{{ section.id }} .cta-media-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    max-height: 320px;
  }

  .closing-cta-{{ section.id }} .cta-btn-contact {
    background-color: #DA6634;
    color: #ffffff !important;
    padding: 15px 36px;
    font-size: 14px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    border-radius: 4px;
    display: inline-block;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .closing-cta-{{ section.id }} .cta-btn-contact:hover {
    background-color: #c75626;
    transform: translateY(-2px);
  }
{% endstyle %}

<section class="closing-cta-{{ section.id }}">
  <div class="cta-inner">
    <h2 class="cta-heading">
      {{ section.settings.heading | default: "Ready to bring bold global flavours to your menu?" }}
    </h2>
    <p class="cta-subheading">
      {{ section.settings.subheading | default: "Get in touch to request samples, discuss commercial pricing, or speak directly with our development team." }}
    </p>

    <!-- Photo between text and CTA -->
    <div class="cta-media-wrap">
      {% if section.settings.cta_image != blank %}
        {{ section.settings.cta_image | image_url: width: 1000 | image_tag: class: 'cta-media-img', alt: 'The Naked Sauce Co showcase' }}
      {% else %}
        <img class="cta-media-img" src="{{ 'sauces-lineup.jpg' | asset_url }}" alt="The Naked Sauce Co bottles and dishes">
      {% endif %}
    </div>

    <a href="/pages/contact" class="cta-btn-contact">
      {{ section.settings.btn_label | default: "Contact us" }}
    </a>
  </div>
</section>

{% schema %}
{
  "name": "Closing Call to Action",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ready to bring bold global flavours to your menu?"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Get in touch to request samples, discuss commercial pricing, or speak directly with our development team."
    },
    {
      "type": "image_picker",
      "id": "cta_image",
      "label": "CTA Image"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Contact us"
    }
  ],
  "presets": [
    {
      "name": "Closing Call to Action"
    }
  ]
}
{% endschema %}
