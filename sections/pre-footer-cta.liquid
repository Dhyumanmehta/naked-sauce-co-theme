{% style %}
  .nsc-cta-section-{{ section.id }} {
    background-color: #141414;
    color: #ffffff;
    padding: 85px 0 95px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .nsc-cta-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 32px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 40px;
    flex-wrap: wrap;
  }

  .nsc-cta-left {
    max-width: 580px;
  }

  .nsc-cta-title {
    font-size: clamp(34px, 4vw, 54px);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0;
    color: #ffffff;
  }

  .nsc-cta-right {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .nsc-cta-btn {
    background-color: #DA6634;
    color: #ffffff !important;
    padding: 16px 36px;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    border-radius: 4px;
    transition: background-color 0.2s ease, transform 0.2s ease;
    display: inline-block;
  }

  .nsc-cta-btn:hover {
    background-color: #c75626;
    transform: translateY(-2px);
  }

  .nsc-cta-email {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    font-weight: 600;
  }

  .nsc-cta-email:hover {
    color: #DA6634;
    text-decoration: underline;
  }

  .nsc-cta-note {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.5);
    margin: 0;
  }
{% endstyle %}

<div class="nsc-cta-section-{{ section.id }}" id="contact">
  <div class="nsc-cta-container">
    <div class="nsc-cta-left">
      <h2 class="nsc-cta-title">
        Ready to bring<br>
        bold global<br>
        flavour to your<br>
        menu?
      </h2>
    </div>

    <div class="nsc-cta-right">
      <a href="/pages/contact" class="nsc-cta-btn">Talk to the team</a>
      <a href="mailto:sales@thenakedsauceco.com" class="nsc-cta-email">sales@thenakedsauceco.com</a>
      <p class="nsc-cta-note">Trade & foodservice enquiries welcome</p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Pre-Footer CTA",
  "tag": "section",
  "settings": [],
  "presets": [
    {
      "name": "Pre-Footer CTA"
    }
  ]
}
{% endschema %}
