{%- style -%}
  :root {
    --nsc-charcoal: #231F1A;
    --nsc-panel-dark: #2A2620;
    --nsc-cream: #FBF3E4;
    --nsc-terracotta: #DA6634;
    --nsc-olive: #5F6B3E;
    --nsc-muted: #D6CDBF;
    --nsc-border: rgba(251, 243, 228, 0.12);
  }

  body {
    background-color: var(--nsc-charcoal) !important;
    color: var(--nsc-cream) !important;
    margin: 0;
    padding: 0;
  }

  .nsc-pass-page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 30px 20px 40px;
    background: radial-gradient(circle at 50% 20%, #2A2620 0%, #231F1A 75%);
    box-sizing: border-box;
  }

  .nsc-pass-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1100px;
    margin: 0 auto;
    width: 100%;
  }

  .nsc-brand-lockup {
    display: inline-flex;
    flex-direction: column;
    text-decoration: none;
    line-height: 0.95;
    text-transform: uppercase;
    color: var(--nsc-cream);
  }

  .nsc-brand-lockup .brand-the {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    opacity: 0.75;
  }

  .nsc-brand-lockup .brand-naked {
    font-size: 24px;
    font-weight: 900;
    letter-spacing: 0.05em;
  }

  .nsc-brand-lockup .brand-sauce-co {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.24em;
    color: var(--nsc-terracotta);
  }

  .nsc-pass-login-btn {
    background: transparent;
    border: 1px solid var(--nsc-border);
    color: var(--nsc-muted);
    padding: 8px 16px;
    border-radius: 50px;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .nsc-pass-login-btn:hover {
    border-color: var(--nsc-cream);
    color: var(--nsc-cream);
  }

  .nsc-pass-main {
    max-width: 760px;
    margin: 60px auto;
    text-align: center;
    width: 100%;
  }

  .nsc-badge-strip {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    margin-bottom: 28px;
  }

  .nsc-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 50px;
    background: rgba(251, 243, 228, 0.06);
    border: 1px solid var(--nsc-border);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--nsc-cream);
  }

  .nsc-pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--nsc-terracotta);
  }

  .nsc-pass-title {
    font-size: clamp(34px, 5.5vw, 56px);
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 1.08;
    text-transform: uppercase;
    margin: 0 0 18px;
    color: #FFFFFF;
  }

  .nsc-pass-title span {
    color: var(--nsc-terracotta);
  }

  .nsc-pass-subtitle {
    font-size: clamp(16px, 2.2vw, 19px);
    line-height: 1.6;
    color: var(--nsc-muted);
    max-width: 600px;
    margin: 0 auto 36px;
  }

  .nsc-pass-form-box {
    background: var(--nsc-panel-dark);
    border: 1px solid var(--nsc-border);
    border-radius: 16px;
    padding: 32px 28px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
    max-width: 580px;
    margin: 0 auto;
  }

  .nsc-form-title {
    font-size: 15px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 8px;
    color: var(--nsc-cream);
  }

  .nsc-form-desc {
    font-size: 13.5px;
    color: var(--nsc-muted);
    margin-bottom: 20px;
  }

  .nsc-input-pill {
    display: flex;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(251, 243, 228, 0.2);
    border-radius: 50px;
    padding: 4px;
    transition: border-color 0.2s ease;
  }

  .nsc-input-pill:focus-within {
    border-color: var(--nsc-terracotta);
  }

  .nsc-input {
    background: transparent;
    border: none;
    outline: none;
    color: var(--nsc-cream);
    font-size: 14px;
    padding: 12px 20px;
    flex-grow: 1;
    min-width: 0;
  }

  .nsc-input::placeholder {
    color: #8C8476;
  }

  .nsc-submit-btn {
    background: var(--nsc-terracotta);
    color: #FFFFFF;
    border: none;
    border-radius: 50px;
    font-size: 12.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 12px 26px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .nsc-submit-btn:hover {
    background: #E87442;
    transform: scale(0.98);
  }

  .nsc-range-stats {
    display: flex;
    justify-content: center;
    gap: 32px;
    margin-top: 36px;
    flex-wrap: wrap;
  }

  .nsc-stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .nsc-stat-num {
    font-size: 20px;
    font-weight: 800;
    color: var(--nsc-cream);
  }

  .nsc-stat-label {
    font-size: 11.5px;
    color: var(--nsc-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .nsc-pass-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    max-width: 1100px;
    margin: 0 auto;
    width: 100%;
    padding-top: 24px;
    border-top: 1px solid var(--nsc-border);
    font-size: 12.5px;
    color: #8C8476;
  }

  .nsc-pass-footer a {
    color: var(--nsc-muted);
    text-decoration: none;
  }

  .nsc-pass-footer a:hover {
    color: var(--nsc-cream);
  }

  .nsc-modal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
    z-index: 9999;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .nsc-modal.is-open {
    display: flex;
  }

  .nsc-modal-card {
    background: var(--nsc-panel-dark);
    border: 1px solid var(--nsc-border);
    border-radius: 16px;
    padding: 36px 30px;
    max-width: 440px;
    width: 100%;
    text-align: center;
    position: relative;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }

  .nsc-modal-close {
    position: absolute;
    top: 14px;
    right: 18px;
    background: none;
    border: none;
    color: var(--nsc-muted);
    font-size: 24px;
    cursor: pointer;
  }
{%- endstyle -%}

<div class="nsc-pass-page">
  <header class="nsc-pass-top">
    <a href="/" class="nsc-brand-lockup">
      <span class="brand-the">the</span>
      <span class="brand-naked">NAKED</span>
      <span class="brand-sauce-co">sauce co.</span>
    </a>
    <button type="button" class="nsc-pass-login-btn" onclick="openPasswordModal()">
      Store Login
    </button>
  </header>

  <main class="nsc-pass-main">
    <div class="nsc-badge-strip">
      <div class="nsc-pill">
        <span class="nsc-pill-dot"></span>
        Free From All 14 Major Allergens
      </div>
      <div class="nsc-pill">
        <span class="nsc-pill-dot" style="background:var(--nsc-olive);"></span>
        100% UPF-Free (NOVA Standard)
      </div>
      <div class="nsc-pill">
        <span class="nsc-pill-dot"></span>
        One Recipe. Every Table.
      </div>
    </div>

    <h1 class="nsc-pass-title">
      BOLD FLAVOUR.<br>
      <span>NOTHING TO HIDE.</span>
    </h1>

    <p class="nsc-pass-subtitle">
      Dinner shouldn't come with a disclaimer. We are putting the finishing touches on our clean-label condiment shop. Sign up to get early access and launch offers.
    </p>

    <div class="nsc-pass-form-box">
      <div class="nsc-form-title">The Clean Sauce Shop Is Coming</div>
      <div class="nsc-form-desc">
        Be first in line when online ordering goes live. No spam—just an invite when the kitchen opens.
      </div>

      {% form 'customer', class: 'nsc-waitlist-form' %}
        {% if form.posted_successfully? %}
          <p class="small mb-2" style="color:#5F6B3E; font-weight:700;">
            ✓ You're on the list! We'll notify you the moment we launch.
          </p>
        {% endif %}
        <input type="hidden" name="contact[tags]" value="newsletter, coming-soon-waitlist">
        <div class="nsc-input-pill">
          <input
            type="email"
            name="contact[email]"
            class="nsc-input"
            placeholder="Enter your email address"
            required
            autocorrect="off"
            autocapitalize="off"
          >
          <button type="submit" class="nsc-submit-btn">
            Notify Me
          </button>
        </div>
      {% endform %}
    </div>

    <div class="nsc-range-stats">
      <div class="nsc-stat-item">
        <span class="nsc-stat-num">15</span>
        <span class="nsc-stat-label">Sauces & Glazes</span>
      </div>
      <div class="nsc-stat-item">
        <span class="nsc-stat-num">3</span>
        <span class="nsc-stat-label">Specialist Ranges</span>
      </div>
      <div class="nsc-stat-item">
        <span class="nsc-stat-num">0</span>
        <span class="nsc-stat-label">Ultra-Processed Additives</span>
      </div>
      <div class="nsc-stat-item">
        <span class="nsc-stat-num">100%</span>
        <span class="nsc-stat-label">Allergen Safe</span>
      </div>
    </div>
  </main>

  <footer class="nsc-pass-footer">
    <div>
      &copy; {{ 'now' | date: '%Y' }} The Naked Sauce Co. All rights reserved.
    </div>
    <div>
      Trade inquiries: <a href="mailto:sales@thenakedsauceco.com">sales@thenakedsauceco.com</a>
    </div>
  </footer>
</div>

<div id="passwordModal" class="nsc-modal">
  <div class="nsc-modal-card">
    <button type="button" class="nsc-modal-close" onclick="closePasswordModal()">&times;</button>
    <h3 style="margin-top:0; color:#FFFFFF; font-size:20px; text-transform:uppercase; letter-spacing:0.08em;">
      Store Access
    </h3>
    <p style="color:var(--nsc-muted); font-size:13.5px; margin-bottom:24px;">
      Enter your store password to preview the site.
    </p>

    {% form 'storefront_password', class: 'password-form' %}
      {% if form.errors %}
        <p style="color:#DA6634; font-size:13px; margin-bottom:12px;">Incorrect password. Please try again.</p>
      {% endif %}
      <div class="nsc-input-pill" style="margin-bottom:16px;">
        <input
          type="password"
          name="password"
          id="Password"
          class="nsc-input"
          placeholder="Enter store password"
          required
        >
        <button type="submit" class="nsc-submit-btn">
          Enter
        </button>
      </div>
    {% endform %}
  </div>
</div>

<script>
  function openPasswordModal() {
    var modal = document.getElementById('passwordModal');
    if (modal) modal.classList.add('is-open');
  }
  function closePasswordModal() {
    var modal = document.getElementById('passwordModal');
    if (modal) modal.classList.remove('is-open');
  }
  window.addEventListener('click', function(e) {
    var modal = document.getElementById('passwordModal');
    if (e.target === modal) {
      closePasswordModal();
    }
  });
</script>

{% schema %}
{
  "name": "Password Page",
  "settings": []
}
{% endschema %}