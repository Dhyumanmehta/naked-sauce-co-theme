{%- style -%}
  :root {
    --nsc-charcoal: #231F1A;
    --nsc-panel-dark: #2A2620;
    --nsc-cream: #FBF3E4;
    --nsc-terracotta: #DA6634;
    --nsc-olive: #5F6B3E;
    --nsc-muted: #D6CDBF;
    --nsc-border: rgba(251, 243, 228, 0.12);
  }

  body {
    background-color: var(--nsc-charcoal) !important;
    color: var(--nsc-cream) !important;
    margin: 0;
    padding: 0;
  }

  .nsc-pass-page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 30px 24px 40px;
    position: relative;
    box-sizing: border-box;
    background-color: var(--nsc-charcoal);
    {% if section.settings.bg_image != blank %}
      background-image: linear-gradient(180deg, rgba(35, 31, 26, 0.88) 0%, rgba(35, 31, 26, 0.96) 100%), url('{{ section.settings.bg_image | image_url: width: 2000 }}');
      background-size: cover;
      background-position: center;
      background-attachment: fixed;
    {% else %}
      background: radial-gradient(circle at 50% 15%, #2F2A23 0%, #231F1A 80%);
    {% endif %}
  }

  /* Top Bar */
  .nsc-pass-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
  }

  .nsc-brand-lockup {
    display: inline-flex;
    flex-direction: column;
    text-decoration: none;
    line-height: 0.95;
    text-transform: uppercase;
    color: var(--nsc-cream);
  }

  .nsc-brand-lockup .brand-the {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    opacity: 0.75;
  }

  .nsc-brand-lockup .brand-naked {
    font-size: 26px;
    font-weight: 900;
    letter-spacing: 0.05em;
  }

  .nsc-brand-lockup .brand-sauce-co {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.24em;
    color: var(--nsc-terracotta);
  }

  .nsc-logo-img {
    max-height: {{ section.settings.logo_height }}px;
    width: auto;
    object-fit: contain;
    display: block;
  }

  .nsc-pass-login-btn {
    background: transparent;
    border: 1px solid var(--nsc-border);
    color: var(--nsc-muted);
    padding: 8px 18px;
    border-radius: 50px;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .nsc-pass-login-btn:hover {
    border-color: var(--nsc-cream);
    color: var(--nsc-cream);
  }

  /* Center Stage */
  .nsc-pass-main {
    max-width: 1100px;
    margin: 40px auto;
    width: 100%;
  }

  .nsc-pass-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: center;
  }

  @media (max-width: 900px) {
    .nsc-pass-grid {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 36px;
    }
  }

  .nsc-badge-strip {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 22px;
  }

  @media (max-width: 900px) {
    .nsc-badge-strip {
      justify-content: center;
    }
  }

  .nsc-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 50px;
    background: rgba(251, 243, 228, 0.08);
    border: 1px solid var(--nsc-border);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--nsc-cream);
  }

  .nsc-pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--nsc-terracotta);
  }

  .nsc-pass-title {
    font-size: clamp(36px, 4.8vw, 56px);
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 1.05;
    text-transform: uppercase;
    margin: 0 0 18px;
    color: #FFFFFF;
  }

  .nsc-pass-title span {
    color: var(--nsc-terracotta);
  }

  .nsc-pass-subtitle {
    font-size: clamp(15px, 1.8vw, 18px);
    line-height: 1.6;
    color: var(--nsc-muted);
    margin: 0 0 28px;
  }

  /* Form Pill Box */
  .nsc-pass-form-box {
    background: var(--nsc-panel-dark);
    border: 1px solid var(--nsc-border);
    border-radius: 14px;
    padding: 24px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
  }

  .nsc-input-pill {
    display: flex;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(251, 243, 228, 0.2);
    border-radius: 50px;
    padding: 4px;
    transition: border-color 0.2s ease;
  }

  .nsc-input-pill:focus-within {
    border-color: var(--nsc-terracotta);
  }

  .nsc-input {
    background: transparent;
    border: none;
    outline: none;
    color: var(--nsc-cream);
    font-size: 14px;
    padding: 12px 20px;
    flex-grow: 1;
    min-width: 0;
  }

  .nsc-input::placeholder {
    color: #8C8476;
  }

  .nsc-submit-btn {
    background: var(--nsc-terracotta);
    color: #FFFFFF;
    border: none;
    border-radius: 50px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 12px 24px;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .nsc-submit-btn:hover {
    background: #E87442;
    transform: scale(0.98);
  }

  /* Imagery Card */
  .nsc-hero-visual {
    position: relative;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid var(--nsc-border);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
    background: var(--nsc-panel-dark);
    aspect-ratio: 4/4.5;
  }

  .nsc-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  .nsc-hero-visual:hover .nsc-hero-img {
    transform: scale(1.03);
  }

  .nsc-hero-overlay-badge {
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: 20px;
    background: rgba(35, 31, 26, 0.88);
    backdrop-filter: blur(10px);
    border: 1px solid var(--nsc-border);
    border-radius: 12px;
    padding: 14px 18px;
    display: flex;
    justify-content: space-around;
    text-align: center;
  }

  .nsc-mini-stat {
    display: flex;
    flex-direction: column;
  }

  .nsc-mini-val {
    font-size: 18px;
    font-weight: 800;
    color: var(--nsc-cream);
    line-height: 1.1;
  }

  .nsc-mini-lbl {
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--nsc-muted);
  }

  /* Footer */
  .nsc-pass-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    padding-top: 24px;
    border-top: 1px solid var(--nsc-border);
    font-size: 12.5px;
    color: #8C8476;
  }

  .nsc-pass-footer a {
    color: var(--nsc-muted);
    text-decoration: none;
  }

  .nsc-pass-footer a:hover {
    color: var(--nsc-cream);
  }

  /* Password Modal */
  .nsc-modal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
    z-index: 9999;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .nsc-modal.is-open {
    display: flex;
  }

  .nsc-modal-card {
    background: var(--nsc-panel-dark);
    border: 1px solid var(--nsc-border);
    border-radius: 16px;
    padding: 36px 30px;
    max-width: 420px;
    width: 100%;
    text-align: center;
    position: relative;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }

  .nsc-modal-close {
    position: absolute;
    top: 14px;
    right: 18px;
    background: none;
    border: none;
    color: var(--nsc-muted);
    font-size: 24px;
    cursor: pointer;
  }
{%- endstyle -%}

<div class="nsc-pass-page">
  <!-- Top Navigation -->
  <header class="nsc-pass-top">
    {% if section.settings.logo != blank %}
      <a href="/">
        {{ section.settings.logo | image_url: width: 500 | image_tag:
          class: 'nsc-logo-img',
          alt: shop.name
        }}
      </a>
    {% elsif settings.logo != blank %}
      <a href="/">
        {{ settings.logo | image_url: width: 500 | image_tag:
          class: 'nsc-logo-img',
          alt: shop.name
        }}
      </a>
    {% else %}
      <a href="/" class="nsc-brand-lockup">
        <span class="brand-the">the</span>
        <span class="brand-naked">NAKED</span>
        <span class="brand-sauce-co">sauce co.</span>
      </a>
    {% endif %}

    <button type="button" class="nsc-pass-login-btn" onclick="openPasswordModal()">
      Store Login
    </button>
  </header>

  <!-- Main Content Grid -->
  <main class="nsc-pass-main">
    <div class="nsc-pass-grid">
      <!-- Left Column: Copy & Form -->
      <div class="nsc-pass-copy">
        <div class="nsc-badge-strip">
          <div class="nsc-pill">
            <span class="nsc-pill-dot"></span>
            14 Major Allergens Free[cite: 8]
          </div>
          <div class="nsc-pill">
            <span class="nsc-pill-dot" style="background:var(--nsc-olive);"></span>
            100% UPF-Free (NOVA)[cite: 8]
          </div>
          <div class="nsc-pill">
            <span class="nsc-pill-dot"></span>
            One Recipe. Every Table.[cite: 8]
          </div>
        </div>

        <h1 class="nsc-pass-title">
          BOLD FLAVOUR.<br>
          <span>NOTHING TO HIDE.</span>[cite: 8]
        </h1>

        <p class="nsc-pass-subtitle">
          Dinner shouldn't come with a disclaimer[cite: 7]. We are preparing 15 sauces across 3 clean-label ranges for our official retail & foodservice launch[cite: 8]. Enter your email to receive early access[cite: 8].
        </p>

        <div class="nsc-pass-form-box">
          {% form 'contact', class: 'nsc-waitlist-form' %}
            {% if form.posted_successfully? %}
              <p class="small mb-2" style="color:#5F6B3E; font-weight:700;">
                ✓ You're on the list! We'll email you the moment the kitchen opens.
              </p>
            {% endif %}
            {% if form.errors %}
              <p class="small mb-2" style="color:#DA6634; font-weight:600;">
                {{ form.errors | default_errors }}
              </p>
            {% endif %}

            <input type="hidden" name="contact[tags]" value="newsletter, coming-soon-waitlist">
            <input type="hidden" name="contact[body]" value="New early access signup from coming soon page.">

            <div class="nsc-input-pill">
              <input
                type="email"
                name="contact[email]"
                class="nsc-input"
                placeholder="Enter your email address"
                required
                autocorrect="off"
                autocapitalize="off"
              >
              <button type="submit" class="nsc-submit-btn">
                Notify Me
              </button>
            </div>
          {% endform %}
        </div>
      </div>

      <!-- Right Column: Featured Imagery Card -->
      <div class="nsc-hero-visual">
        {% if section.settings.featured_image != blank %}
          {{ section.settings.featured_image | image_url: width: 1000 | image_tag:
            class: 'nsc-hero-img',
            alt: 'The Naked Sauce Co. Artisan Sauces'
          }}
        {% else %}
          <div style="width:100%; height:100%; background: linear-gradient(135deg, #3A2B20 0%, #231F1A 100%); display:flex; align-items:center; justify-content:center;">
            <span style="color:var(--nsc-muted); font-size:14px; letter-spacing:0.1em; text-transform:uppercase;">Select Hero Image In Theme Editor</span>
          </div>
        {% endif %}

        <div class="nsc-hero-overlay-badge">
          <div class="nsc-mini-stat">
            <span class="nsc-mini-val">15</span>
            <span class="nsc-mini-lbl">Sauces</span>[cite: 8]
          </div>
          <div class="nsc-mini-stat">
            <span class="nsc-mini-val">3</span>
            <span class="nsc-mini-lbl">Ranges</span>[cite: 8]
          </div>
          <div class="nsc-mini-stat">
            <span class="nsc-mini-val">0</span>
            <span class="nsc-mini-lbl">Additives</span>[cite: 8]
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- Footer -->
  <footer class="nsc-pass-footer">
    <div>
      &copy; {{ 'now' | date: '%Y' }} The Naked Sauce Co. All rights reserved.
    </div>
    <div>
      Trade & Foodservice: <a href="mailto:sales@thenakedsauceco.com">sales@thenakedsauceco.com</a>[cite: 8]
    </div>
  </footer>
</div>

<!-- Password Access Modal -->
<div id="passwordModal" class="nsc-modal">
  <div class="nsc-modal-card">
    <button type="button" class="nsc-modal-close" onclick="closePasswordModal()">&times;</button>
    <h3 style="margin-top:0; color:#FFFFFF; font-size:20px; text-transform:uppercase; letter-spacing:0.08em;">
      Store Access
    </h3>
    <p style="color:var(--nsc-muted); font-size:13.5px; margin-bottom:20px;">
      Enter your store password to preview the site.
    </p>

    {% form 'storefront_password', class: 'password-form' %}
      {% if form.errors %}
        <p style="color:#DA6634; font-size:13px; margin-bottom:12px;">Incorrect password. Please try again.</p>
      {% endif %}
      <div class="nsc-input-pill" style="margin-bottom:12px;">
        <input
          type="password"
          name="password"
          id="Password"
          class="nsc-input"
          placeholder="Enter store password"
          required
        >
        <button type="submit" class="nsc-submit-btn">
          Enter
        </button>
      </div>
    {% endform %}
  </div>
</div>

<script>
  function openPasswordModal() {
    var modal = document.getElementById('passwordModal');
    if (modal) modal.classList.add('is-open');
  }
  function closePasswordModal() {
    var modal = document.getElementById('passwordModal');
    if (modal) modal.classList.remove('is-open');
  }
  window.addEventListener('click', function(e) {
    var modal = document.getElementById('passwordModal');
    if (e.target === modal) {
      closePasswordModal();
    }
  });
</script>

{% schema %}
{
  "name": "Password Page",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom Logo Image"
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 30,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Logo Height",
      "default": 55
    },
    {
      "type": "image_picker",
      "id": "featured_image",
      "label": "Featured Sauce Card Image"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Optional Page Background Image"
    }
  ]
}
{% endschema %}