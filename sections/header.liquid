{% style %}
  :root {
    --nsc-header-bg: {{ section.settings.color_background | default: '#FBF3E4' }};
    --nsc-header-text: {{ section.settings.color_text | default: '#1B1310' }};
    --nsc-header-accent: #DA6634;
    --nsc-header-border: rgba(27, 19, 16, 0.1);
  }

  .site-header {
    background-color: var(--nsc-header-bg);
    color: var(--nsc-header-text);
    border-bottom: 1px solid var(--nsc-header-border);
    transition: background-color 0.25s ease;
    padding-top: {{ section.settings.padding_top | times: 4 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 4 }}px;
  }

  /* Logo Typography & Brand Fallback */
  .nsc-brand-lockup {
    display: inline-flex;
    flex-direction: column;
    text-decoration: none;
    line-height: 0.95;
    font-family: inherit;
    text-transform: uppercase;
    color: var(--nsc-header-text) !important;
  }

  .nsc-brand-lockup .brand-the {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    opacity: 0.75;
  }

  .nsc-brand-lockup .brand-naked {
    font-size: 24px;
    font-weight: 900;
    letter-spacing: 0.04em;
    color: var(--nsc-header-text);
  }

  .nsc-brand-lockup .brand-sauce-co {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.22em;
    color: var(--nsc-header-accent);
  }

  .header__heading-logo {
    display: block;
    max-height: 65px;
    width: auto;
    object-fit: contain;
  }

  /* Navigation Links */
  .site-header .site-nav__link {
    color: var(--nsc-header-text) !important;
    font-size: 14.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 10px 18px !important;
    text-decoration: none;
    position: relative;
    transition: color 0.2s ease;
  }

  .site-header .site-nav__link:hover,
  .site-header .site-nav__link--active {
    color: var(--nsc-header-accent) !important;
  }

  /* Utility Icons */
  .site-header__icons-wrapper .site-header__icon {
    color: var(--nsc-header-text);
    background: none;
    border: none;
    padding: 8px 10px;
    font-size: 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    position: relative;
    transition: color 0.2s ease, transform 0.15s ease;
  }

  .site-header__icons-wrapper .site-header__icon:hover {
    color: var(--nsc-header-accent);
    transform: scale(1.08);
  }

  .site-header .site-header__cart-count {
    position: absolute;
    top: 2px;
    right: 2px;
    background: var(--nsc-header-accent);
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 700;
    height: 18px;
    width: 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  /* Hamburger Menu Button */
  .hamburger-menu {
    cursor: pointer;
    padding: 10px 4px;
    display: flex;
    align-items: center;
  }

  .hamburger-inner,
  .hamburger-inner::before,
  .hamburger-inner::after {
    width: 22px;
    height: 2px;
    background-color: var(--nsc-header-text);
    display: block;
    transition: transform 0.2s ease;
  }

  .hamburger-inner { position: relative; }
  .hamburger-inner::before,
  .hamburger-inner::after { content: ''; position: absolute; }
  .hamburger-inner::before { top: -6px; }
  .hamburger-inner::after { top: 6px; }

  /* Offcanvas Styling */
  .offcanvas {
    background-color: var(--nsc-header-bg);
    color: var(--nsc-header-text);
  }
  .offcanvas .site-nav__link {
    font-size: 18px;
    display: block;
    padding: 12px 24px !important;
    border-bottom: 1px solid rgba(0,0,0,0.05);
  }
{% endstyle %}

<!-- Mobile OffCanvas Drawer -->
<div class="offcanvas offcanvas-start" tabindex="-1" id="offcanvasMenu" aria-labelledby="offcanvasMenuLabel">
  <div class="offcanvas-header border-bottom px-4 py-3 d-flex justify-content-between align-items-center">
    <div class="nsc-brand-lockup">
      <span class="brand-the">the</span>
      <span class="brand-naked">NAKED</span>
      <span class="brand-sauce-co">sauce co.</span>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>
  <div class="offcanvas-body p-0">
    {% render 'site-nav', linklist: section.settings.main_linklist, class: 'list-unstyled mb-0' %}
  </div>
</div>

<div class="header-wrapper position-relative">
  <header class="site-header" role="banner" data-section-id="{{ section.id }}">
    <div class="container page-width">
      <div class="row align-items-center justify-content-between">
        
        <!-- Mobile Hamburger & Desktop Left Links (when centered logo) -->
        <div class="col-3 col-lg-4 d-flex align-items-center">
          <div class="d-lg-none">
            <div class="hamburger-menu" data-bs-toggle="offcanvas" data-bs-target="#offcanvasMenu" aria-controls="offcanvasMenu">
              <span class="hamburger-inner"></span>
            </div>
          </div>
          {% if section.settings.logo_position == 'middle-center' %}
            <nav class="d-none d-lg-block">
              {% render 'site-nav', linklist: section.settings.main_linklist, class: 'list-inline mb-0 d-flex' %}
            </nav>
          {% endif %}
        </div>

        <!-- Brand / Logo Area -->
        <div class="col-6 col-lg-4 text-center">
          {% if request.page_type == 'index' %}<h1 class="h6 mb-0 d-inline-block">{% endif %}
            {% if settings.logo != blank %}
              <a href="{{ routes.root_url }}" class="site-header__logo-image d-inline-flex justify-content-center">
                {{ settings.logo | image_url: width: 400 | image_tag:
                  class: 'header__heading-logo',
                  alt: shop.name,
                  preload: true
                }}
              </a>
            {% else %}
              <a href="{{ routes.root_url }}" class="nsc-brand-lockup">
                <span class="brand-the">the</span>
                <span class="brand-naked">NAKED</span>
                <span class="brand-sauce-co">sauce co.</span>
              </a>
            {% endif %}
          {% if request.page_type == 'index' %}</h1>{% endif %}
        </div>

        <!-- Action Icons (Search / Account / Cart) -->
        <div class="col-3 col-lg-4 d-flex justify-content-end align-items-center">
          <div class="site-header__icons-wrapper d-flex align-items-center gap-1">
            
            {% if section.settings.enable_search %}
              <button type="button" class="site-header__icon" data-bs-toggle="modal" data-bs-target="#modalSearch" aria-label="Search">
                {% render 'icon-search' %}
              </button>
            {% endif %}

            {% if shop.customer_accounts_enabled and section.settings.enable_account %}
              <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="site-header__icon" aria-label="Account">
                {% render 'icon-login' %}
              </a>
            {% endif %}

            {% if settings.enable_wishlist and section.settings.enable_wishlist %}
              <a href="{{ settings.wishlist_page.url }}" class="site-header__icon position-relative" aria-label="Wishlist">
                {% render 'icon-heart' %}
              </a>
            {% endif %}

            {% if section.settings.enable_cart %}
              <a href="{{ routes.cart_url }}" class="site-header__icon position-relative" aria-label="Cart">
                <i class="bi bi-bag"></i>
                <div id="CartCount" class="site-header__cart-count{% if cart.item_count == 0 %} d-none{% endif %}" data-cart-count-bubble>
                  <span data-cart-count>{{ cart.item_count }}</span>
                </div>
              </a>
            {% endif %}

          </div>
        </div>

      </div>
    </div>
  </header>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "main_linklist",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "select",
      "id": "logo_position",
      "options": [
        { "value": "middle-center", "label": "Centered Logo" },
        { "value": "middle-left", "label": "Left-Aligned Logo" }
      ],
      "default": "middle-center",
      "label": "Header Layout"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "Background Color",
      "default": "#FBF3E4"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Text & Icons Color",
      "default": "#1B1310"
    },
    {
      "type": "checkbox",
      "id": "enable_search",
      "default": true,
      "label": "Enable search"
    },
    {
      "type": "checkbox",
      "id": "enable_account",
      "default": true,
      "label": "Enable account"
    },
    {
      "type": "checkbox",
      "id": "enable_wishlist",
      "default": false,
      "label": "Enable wishlist"
    },
    {
      "type": "checkbox",
      "id": "enable_cart",
      "default": true,
      "label": "Enable cart"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 3,
      "label": "Top Spacing"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 3,
      "label": "Bottom Spacing"
    }
  ]
}
{% endschema %}