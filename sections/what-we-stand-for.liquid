.stand-for-{{ section.id }} .stand-card {
    background-color: #2B1E19;
    border: 1.5px solid #C85D2F;
    border-radius: 14px;
    padding: 34px 28px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  /* Fixed height / min-height so all 4 titles occupy the exact same space */
  .stand-for-{{ section.id }} .stand-card-title {
    font-size: 22px;
    font-weight: 800;
    color: #E26829;
    margin: 0 0 16px;
    line-height: 1.25;
    letter-spacing: -0.01em;
    min-height: 56px; /* Ensures 1-line and 2-line headings align the body text beneath */
    display: flex;
    align-items: flex-start;
  }

  .stand-for-{{ section.id }} .stand-card-desc {
    font-size: 14.5px;
    color: #D8CEBE;
    line-height: 1.6;
    margin: 0;
  }
