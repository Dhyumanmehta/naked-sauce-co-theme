{% style %}
  .nsc-stand-section-{{ section.id }} {
    background-color: #27211C !important;
    color: #ffffff;
    padding: 100px 0 110px;
    border-top: 1px solid rgba(218, 102, 52, 0.25);
    border-bottom: 1px solid rgba(218, 102, 52, 0.25);
  }

  .nsc-stand-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .nsc-stand-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 48px;
    gap: 30px;
    flex-wrap: wrap;
  }

  .nsc-stand-title {
    font-size: clamp(38px, 4.5vw, 56px);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin: 0;
  }

  .nsc-stand-sub {
    font-size: clamp(15px, 1.2vw, 18px);
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.4;
    margin: 0;
    max-width: 440px;
    text-align: right;
  }

  @media (max-width: 768px) {
    .nsc-stand-header-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
    .nsc-stand-sub {
      text-align: left;
    }
  }

  .nsc-stand-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  @media (max-width: 1024px) {
    .nsc-stand-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .nsc-stand-grid {
      grid-template-columns: 1fr;
    }
  }

  .nsc-stand-card {
    background: rgba(218, 102, 52, 0.08) !important;
    border: 2px solid #DA6634 !important;
    border-radius: 10px;
    padding: 34px 26px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .nsc-stand-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 25px rgba(218, 102, 52, 0.25);
  }

  .nsc-stand-card-title {
    font-size: 21px;
    font-weight: 800;
    color: #DA6634 !important;
    line-height: 1.25;
    margin: 0 0 14px;
  }

  .nsc-stand-card-desc {
    font-size: 14.5px;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.85);
    margin: 0;
  }
{% endstyle %}

<div class="nsc-stand-section-{{ section.id }}" id="our-story">
  <div class="nsc-stand-container">
    <div class="nsc-stand-header-row">
      <h2 class="nsc-stand-title">What we stand for</h2>
      <p class="nsc-stand-sub">Sauce with nothing to hide. Four promises behind every recipe</p>
    </div>

    <div class="nsc-stand-grid">
      <div class="nsc-stand-card">
        <h3 class="nsc-stand-card-title">Free from the major allergens</h3>
        <p class="nsc-stand-card-desc">Safe to serve to more of your customers, without a separate recipe.</p>
      </div>

      <div class="nsc-stand-card">
        <h3 class="nsc-stand-card-title">Zero ultra-processed ingredients</h3>
        <p class="nsc-stand-card-desc">Nothing artificial, nothing you'd need to look up.</p>
      </div>

      <div class="nsc-stand-card">
        <h3 class="nsc-stand-card-title">Real, natural ingredients</h3>
        <p class="nsc-stand-card-desc">Proper ingredients, cooked for big honest flavour.</p>
      </div>

      <div class="nsc-stand-card">
        <h3 class="nsc-stand-card-title">Reassuringly clean label
          
        </h3>
        <p class="nsc-stand-card-desc">A sauce or glaze that stands out for the right reasons.</p>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "What We Stand For",
  "tag": "section",
  "presets": [
    { "name": "What We Stand For" }
  ]
}
{% endschema %}
